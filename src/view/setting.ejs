
<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Setting - WebClinic</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <style>
    body { background: #f5f7fb; }
    main { min-width: 0; }
    .page-title { color: #24364b; font-weight: 700; }
    .setting-card { border: 0; border-radius: 14px; box-shadow: 0 3px 15px rgba(30,50,80,.05); }
    .profile-image { width: 112px; height: 112px; border-radius: 50%; object-fit: cover; border: 3px solid #e5edf5; }
    .profile-placeholder { width: 112px; height: 112px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #eaf1f8; color: #315f85; font-size: 40px; }
    .section-title { color: #315f85; font-weight: 700; }
    .form-label { font-weight: 600; }
    @media(max-width:576px) { main { padding: 1rem !important; } }
  </style>
</head>
<body>
  <%- include('partial/navbar') %>
  <div class="container-fluid">
    <div class="row">
      <%- include('partial/menu') %>
      <main class="col-md-9 col-lg-10 p-4">
        <div class="mb-4">
          <h2 class="page-title mb-1"><i class="fa-solid fa-gear text-primary me-2"></i>Setting</h2>
          <p class="text-secondary mb-0">ตั้งค่าบัญชีและจัดการข้อมูลส่วนตัว</p>
        </div>

        <% if (success) { %>
          <div class="alert alert-success alert-dismissible fade show"><i class="fa-solid fa-circle-check me-2"></i><%= success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>
        <% if (error) { %>
          <div class="alert alert-danger alert-dismissible fade show"><i class="fa-solid fa-circle-exclamation me-2"></i><%= error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>

        <div class="row g-4">
          <div class="col-12">
            <section class="card setting-card">
              <div class="card-body p-4">
                <h5 class="section-title mb-4"><i class="fa-solid fa-user-shield me-2"></i>ข้อมูลบัญชี</h5>
                <div class="row g-3">
                  <div class="col-md-6">
                    <label class="form-label">อีเมล</label>
                    <input class="form-control" value="<%= account.email %>" readonly>
                    <div class="form-text">ไม่สามารถเปลี่ยนอีเมลผ่านหน้านี้ได้</div>
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">ประเภทบัญชี</label>
                    <input class="form-control" value="<%= role === 'clinic_staff' ? 'Clinic Staff' : role === 'vet' ? 'Veterinarian' : 'Clinic' %>" readonly>
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">สถานะบัญชี</label>
                    <input class="form-control" value="<%= account.status === 'active' ? 'Active' : 'Inactive' %>" readonly>
                  </div>
                </div>
<div class="mt-4">
  <a href="/settings/password" class="btn btn-outline-primary">
    <i class="fa-solid fa-key me-2"></i>เปลี่ยนรหัสผ่าน
  </a>
  <small class="text-muted ms-2">ต้องยืนยัน OTP ทางอีเมลก่อน</small>
</div>
              </div>
            </section>
          </div>

          <div class="col-12">
            <section class="card setting-card">
              <div class="card-body p-4">
                <h5 class="section-title mb-4"><i class="fa-solid fa-address-card me-2"></i>ข้อมูลส่วนตัว</h5>

                <% if (role === 'clinic') { %>
  <form action="/settings/clinic" method="POST" enctype="multipart/form-data" id="clinicProfileForm">
    <div class="text-center mb-4">
      <div id="clinicImagePreview">
        <% if (profile.profile_image_url) { %>
          <img src="<%= profile.profile_image_url %>" class="profile-image" alt="Clinic profile">
        <% } else { %>
          <div class="profile-placeholder mx-auto"><i class="fa-solid fa-hospital"></i></div>
        <% } %>
      </div>
      <h5 class="mt-3 mb-1"><%= profile.clinic_name %></h5>
      <span class="badge text-bg-secondary"><%= profile.type === 'hospital' ? 'Hospital' : 'Clinic' %></span>
    </div>

    <div class="alert alert-warning">
      <i class="fa-solid fa-triangle-exclamation me-2"></i>
      ชื่อคลินิก ที่อยู่ ประเภทคลินิก และเวลาเปิด–ปิด เป็นข้อมูลที่ต้องมีเอกสารยืนยัน 
    </div>

    <h6 class="section-title mb-3">ข้อมูลที่แก้ไขได้</h6>
    <div class="row g-3">
      <div class="col-12">
        <label for="clinic_profile_image" class="form-label">รูปโปรไฟล์คลินิก</label>
        <input type="file" name="profile_image" id="clinic_profile_image" class="form-control" accept="image/jpeg,image/png,image/webp">
        <div class="form-text">รองรับ JPG, PNG, WEBP ขนาดไม่เกิน 5 MB รูปเดิมจะถูกลบจาก Cloudinary เมื่อบันทึกรูปใหม่สำเร็จ</div>
      </div>
      <div class="col-md-6">
        <label for="clinic_phone" class="form-label">เบอร์โทรศัพท์</label>
        <input type="tel" name="phone" id="clinic_phone" class="form-control" maxlength="20" value="<%= profile.phone || '' %>">
      </div>
      <div class="col-12">
        <label for="google_map_url" class="form-label">Google Map URL</label>
        <input type="url" name="google_map_url" id="google_map_url" class="form-control" maxlength="2000" value="<%= profile.google_map_url || '' %>" placeholder="https://maps.google.com/...">
      </div>
      <div class="col-md-6">
        <label for="latitude" class="form-label">Latitude (ละติจูด)</label>
        <input type="number" name="latitude" id="latitude" class="form-control" min="-90" max="90" step="0.000001" value="<%= profile.latitude ?? '' %>">
      </div>
      <div class="col-md-6">
        <label for="longitude" class="form-label">Longitude (ลองจิจูด)</label>
        <input type="number" name="longitude" id="longitude" class="form-control" min="-180" max="180" step="0.000001" value="<%= profile.longitude ?? '' %>">
      </div>
    </div>

    <hr class="my-4">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
      <h6 class="section-title mb-0">ข้อมูลที่ต้องมีเอกสารยืนยัน</h6>
      <button type="button" class="btn btn-sm btn-outline-secondary" id="toggleClinicDebug">
        <i class="fa-solid fa-bug me-1"></i>เปิดโหมด Debug
      </button>
    </div>
    <div class="alert alert-danger d-none" id="clinicDebugWarning">
      <i class="fa-solid fa-triangle-exclamation me-2"></i>
      โหมด Debug เปิดอยู่ ข้อมูลต่อไปนี้จะสามารถแก้ไขได้ ใช้สำหรับทดสอบเท่านั้น
    </div>

    <input type="hidden" name="debug_mode" id="clinicDebugMode" value="0">

    <div class="row g-3">
      <div class="col-md-6">
        <label class="form-label">ชื่อคลินิก</label>
        <input class="form-control clinic-debug-field" name="clinic_name" value="<%= profile.clinic_name || '' %>" maxlength="255" disabled>
      </div>
      <div class="col-md-6">
        <label class="form-label">ประเภทคลินิก</label>
        <select class="form-select clinic-debug-field" name="type" disabled>
          <option value="clinic" <%= profile.type === 'clinic' ? 'selected' : '' %>>Clinic</option>
          <option value="hospital" <%= profile.type === 'hospital' ? 'selected' : '' %>>Hospital</option>
        </select>
      </div>
      <div class="col-12">
        <label class="form-label">ที่อยู่</label>
        <input class="form-control clinic-debug-field mb-2" name="address_line" placeholder="บ้านเลขที่ ถนน อาคาร" value="<%= profile.address_line || '' %>" disabled>
      </div>
      <div class="col-md-6">
        <label class="form-label">ตำบล / แขวง</label>
        <input class="form-control clinic-debug-field" name="subdistrict" value="<%= profile.subdistrict || '' %>" disabled>
      </div>
      <div class="col-md-6">
        <label class="form-label">อำเภอ / เขต</label>
        <input class="form-control clinic-debug-field" name="district" value="<%= profile.district || '' %>" disabled>
      </div>
      <div class="col-md-6">
        <label class="form-label">จังหวัด</label>
        <input class="form-control clinic-debug-field" name="province" value="<%= profile.province || '' %>" disabled>
      </div>
      <div class="col-md-6">
        <label class="form-label">รหัสไปรษณีย์</label>
        <input class="form-control clinic-debug-field" name="postal_code" maxlength="10" value="<%= profile.postal_code || '' %>" disabled>
      </div>
      <div class="col-md-6">
        <label class="form-label">เวลาเปิด</label>
        <input type="time" class="form-control clinic-debug-field" name="open_time" value="<%= profile.open_time ? String(profile.open_time).slice(0,5) : '' %>" disabled>
      </div>
      <div class="col-md-6">
        <label class="form-label">เวลาปิด</label>
        <input type="time" class="form-control clinic-debug-field" name="close_time" value="<%= profile.close_time ? String(profile.close_time).slice(0,5) : '' %>" disabled>
      </div>
    </div>

    <div class="d-flex justify-content-end mt-4">
      <button type="submit" class="btn btn-primary" id="saveClinicProfile">
        <i class="fa-solid fa-floppy-disk me-2"></i>บันทึกข้อมูล
      </button>
    </div>
  </form>
<% } else {  %>
                  <form action="/settings/profile" method="POST" enctype="multipart/form-data" id="profileForm">
                    <div class="row g-4">
                      <div class="col-12">
                        <div class="d-flex align-items-center gap-4 flex-wrap">
                          <div id="imagePreview">
                            <% if (profile.profile_image_url) { %>
                              <img src="<%= profile.profile_image_url %>" class="profile-image" alt="Profile">
                            <% } else { %>
                              <div class="profile-placeholder"><i class="fa-solid fa-user"></i></div>
                            <% } %>
                          </div>
                          <div>
                            <label for="profile_image" class="form-label">รูปโปรไฟล์</label>
                            <input type="file" name="profile_image" id="profile_image" class="form-control" accept="image/jpeg,image/png,image/webp">
                            <div class="form-text">รองรับ JPG, PNG, WEBP ขนาดไม่เกิน 5 MB</div>
                            <% if (profile.profile_image_url) { %>
                              <button type="button" class="btn btn-sm btn-outline-danger mt-2" data-bs-toggle="modal" data-bs-target="#deleteImageModal"><i class="fa-solid fa-trash me-1"></i>ลบรูปโปรไฟล์</button>
                            <% } %>
                          </div>
                        </div>
                      </div>
                      <div class="col-md-6">
                        <label for="first_name" class="form-label">ชื่อ <span class="text-danger">*</span></label>
                        <input type="text" name="first_name" id="first_name" class="form-control" maxlength="100" value="<%= profile.first_name || '' %>" required>
                      </div>
                      <div class="col-md-6">
                        <label for="last_name" class="form-label">นามสกุล <span class="text-danger">*</span></label>
                        <input type="text" name="last_name" id="last_name" class="form-control" maxlength="100" value="<%= profile.last_name || '' %>" required>
                      </div>
                      <div class="col-md-6">
                        <label for="phone" class="form-label">เบอร์โทรศัพท์</label>
                        <input type="tel" name="phone" id="phone" class="form-control" maxlength="20" value="<%= profile.phone || '' %>">
                      </div>
                      <% if (role === 'vet') { %>
                        <div class="col-md-6">
                          <label class="form-label">Vet Class</label>
                          <input class="form-control" value="Class <%= profile.vet_class %>" readonly>
                          <div class="form-text">ไม่สามารถแก้ไข Vet Class จากหน้านี้ได้</div>
                        </div>
                      <% } %>
                    </div>
                    <div class="d-flex justify-content-end mt-4">
                      <button type="submit" class="btn btn-primary" id="saveProfile"><i class="fa-solid fa-floppy-disk me-2"></i>บันทึกข้อมูล</button>
                    </div>
                  </form>

                  <% if (profile.profile_image_url) { %>
                    <div class="modal fade" id="deleteImageModal" tabindex="-1" aria-hidden="true">
                      <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                          <div class="modal-header"><h5 class="modal-title">ยืนยันการลบรูปโปรไฟล์</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                          <div class="modal-body">คุณต้องการลบรูปโปรไฟล์นี้หรือไม่? รูปจะถูกนำออกจาก Cloudinary ด้วย</div>
                          <div class="modal-footer">
                            <button type="button" class="btn btn-light" data-bs-dismiss="modal">ยกเลิก</button>
                            <form action="/settings/profile/image/delete" method="POST"><button type="submit" class="btn btn-danger">ยืนยันลบรูป</button></form>
                          </div>
                        </div>
                      </div>
                    </div>
                  <% } %>
                <% } %>
              </div>
            </section>
          </div>
        </div>
      </main>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const imageInput = document.getElementById('profile_image');
    const imagePreview = document.getElementById('imagePreview');
    if (imageInput) {
      imageInput.addEventListener('change', () => {
        const file = imageInput.files[0];
        if (!file) return;
        if (!['image/jpeg', 'image/png', 'image/webp'].includes(file.type) || file.size > 5 * 1024 * 1024) {
          alert('กรุณาเลือก JPG, PNG หรือ WEBP ขนาดไม่เกิน 5 MB');
          imageInput.value = '';
          return;
        }
        const imageUrl = URL.createObjectURL(file);
        imagePreview.innerHTML = '';
        const img = document.createElement('img');
        img.src = imageUrl;
        img.className = 'profile-image';
        img.alt = 'Profile preview';
        imagePreview.appendChild(img);
      });
    }
    const profileForm = document.getElementById('profileForm');
    if (profileForm) {
      profileForm.addEventListener('submit', () => {
        const button = document.getElementById('saveProfile');
        button.disabled = true;
        button.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>กำลังบันทึก...';
      });
    }


    
const clinicImageInput = document.getElementById('clinic_profile_image');
const clinicImagePreview = document.getElementById('clinicImagePreview');
if (clinicImageInput) {
  clinicImageInput.addEventListener('change', () => {
    const file = clinicImageInput.files[0];
    if (!file) return;
    if (!['image/jpeg', 'image/png', 'image/webp'].includes(file.type) || file.size > 5 * 1024 * 1024) {
      alert('กรุณาเลือก JPG, PNG หรือ WEBP ขนาดไม่เกิน 5 MB');
      clinicImageInput.value = '';
      return;
    }
    const img = document.createElement('img');
    img.src = URL.createObjectURL(file);
    img.className = 'profile-image';
    img.alt = 'Clinic profile preview';
    clinicImagePreview.replaceChildren(img);
  });
}
const debugButton = document.getElementById('toggleClinicDebug');
if (debugButton) {
  debugButton.addEventListener('click', () => {
    const enabled = document.getElementById('clinicDebugMode').value !== '1';
    document.getElementById('clinicDebugMode').value = enabled ? '1' : '0';
    document.querySelectorAll('.clinic-debug-field').forEach(field => {
      field.disabled = !enabled;
    });
    document.getElementById('clinicDebugWarning').classList.toggle('d-none', !enabled);
    debugButton.innerHTML = enabled
      ? '<i class="fa-solid fa-lock me-1"></i>ปิดโหมด Debug'
      : '<i class="fa-solid fa-bug me-1"></i>เปิดโหมด Debug';
    debugButton.classList.toggle('btn-danger', enabled);
    debugButton.classList.toggle('btn-outline-secondary', !enabled);
  });
}
const clinicProfileForm = document.getElementById('clinicProfileForm');
if (clinicProfileForm) {
  clinicProfileForm.addEventListener('submit', () => {
    const button = document.getElementById('saveClinicProfile');
    button.disabled = true;
    button.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>กำลังบันทึก...';
  });
}



  </script>
</body>
</html>
