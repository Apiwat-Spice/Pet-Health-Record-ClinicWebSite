
<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Stock Overview - WebClinic</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <style>
    @media (max-width: 576px) {
      main {
        padding: 1rem !important;
      }
    }
    .stock-card {
      border: 0;
      box-shadow: 0 .125rem .5rem rgba(0,0,0,.06);
    }
    .stock-table {
      width: 100%;
    }
    .stock-table th {
      white-space: nowrap;
    }
    .stock-table td {
      vertical-align: middle;
    }
    .note-column {
      width: 250px;
      max-width: 250px;
    }
    .note-text {
      display: block;
      width: 250px;
      max-width: 250px;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }
    .stock-detail-note {
      width: 100%;
      max-width: 100%;
      max-height: 150px;
      padding: 12px 15px;
      background: #f8f9fa;
      border: 1px solid #dee2e6;
      border-radius: 8px;
      color: #495057;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
      word-break: break-word;
      overflow-y: auto;
      line-height: 1.6;
    }
    #stockDetailContent {
      min-width: 0;
      margin-left: 0;
      margin-right: 0;
    }
    #stockDetailContent > div {
      min-width: 0;
    }
    .stock-detail-value {
      overflow-wrap: anywhere;
      word-break: break-word;
    }

  .stock-detail-note {
    width: 100%;
    max-height: 150px;
    padding: 14px;
    background: #f8f9fa;
    border: 1px solid #dee2e6;
    border-radius: 8px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    word-break: break-word;
    overflow-y: auto;
    line-height: 1.7;
    color: #495057;
  }

  .stock-detail-item {
    height: 100%;
    padding: 13px 15px;
    border: 1px solid #dee2e6;
    border-radius: 8px;
    background: #fff;
    min-width: 0;
  }

  .stock-detail-item .detail-label {
    font-size: .85rem;
    color: #6c757d;
    margin-bottom: 5px;
  }

  .stock-detail-item .detail-value {
    font-weight: 600;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  #stockDetailName {
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  </style>
</head>
<body class="bg-light">
  <%- include('../partial/navbar') %>
  <div class="container-fluid">
    <div class="row">
      <%- include('../partial/menu') %>
      <main class="col-md-9 col-lg-10 p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
          <div>
            <h2 class="fw-bold"><i class="fa-solid fa-boxes-stacked text-primary me-2"></i>Stock Overview</h2>
            <p class="text-muted mb-0">จัดการสินค้าและตรวจสอบจำนวนคงเหลือในคลินิก</p>
          </div>
          <a href="/stock/create" class="btn btn-success">
            <i class="fa-solid fa-plus me-1"></i> เพิ่มสินค้า
          </a>
        </div>

        <% if (locals.success) { %>
          <div class="alert alert-success alert-dismissible fade show">
            <i class="fa-solid fa-circle-check me-2"></i><%= success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>
        <% if (locals.error) { %>
          <div class="alert alert-danger alert-dismissible fade show">
            <i class="fa-solid fa-circle-exclamation me-2"></i><%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>

        <div class="row g-3 mb-4">
          <div class="col-sm-6 col-xl-4">
            <div class="card stock-card h-100">
              <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 bg-primary-subtle text-primary p-3">
                  <i class="fa-solid fa-boxes-stacked fa-xl"></i>
                </div>
                <div>
                  <div class="text-muted small">รายการสินค้าทั้งหมด</div>
                  <div class="fs-4 fw-bold"><%= stocks.length %></div>
                </div>
              </div>
            </div>
          </div>
          <div class="col-sm-6 col-xl-4">
            <div class="card stock-card h-100">
              <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 bg-success-subtle text-success p-3">
                  <i class="fa-solid fa-cubes-stacked fa-xl"></i>
                </div>
                <div>
                  <div class="text-muted small">จำนวนรวมทุกหน่วย</div>
                  <div class="fs-4 fw-bold"><%= stocks.reduce((sum, s) => sum + Number(s.quantity || 0), 0).toLocaleString('en-US') %></div>
                </div>
              </div>
            </div>
          </div>
          <div class="col-sm-6 col-xl-4">
            <div class="card stock-card h-100">
              <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 bg-danger-subtle text-danger p-3">
                  <i class="fa-solid fa-calendar-xmark fa-xl"></i>
                </div>
                <div>
                  <div class="text-muted small">หมดอายุแล้ว</div>
                  <div class="fs-4 fw-bold"><%= stocks.filter(s => s.current_expired).length %></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="card stock-card">
          <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
              <h5 class="fw-bold mb-0">รายการสินค้า</h5>
              <div class="input-group" style="max-width: 350px;">
                <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass"></i></span>
                <input type="search" id="stockSearch" class="form-control" placeholder="ค้นหาสินค้า บริษัท หรือหมวดหมู่">
              </div>
            </div>

            <div class="table-responsive">
              <table class="table table-hover stock-table align-middle">
                <thead class="table-light">
                  <tr>
                    <th>#</th>
                    <th>ชื่อสินค้า</th>
                    <th>บริษัท</th>
                    <th>หมวดหมู่</th>
                    <th>จำนวน</th>
                    <th>ราคา/หน่วย</th>
                    <th>วันหมดอายุ</th>
                    <th>สถานะ</th>
                    <th>หมายเหตุ</th>
                    <th class="text-center">จัดการ</th>
                  </tr>
                </thead>
                <tbody id="stockTableBody">
                  <% stocks.forEach((stock, index) => { %>
                    <tr data-search="<%= [stock.name, stock.company, stock.category, stock.type_unit, stock.note].join(' ').toLowerCase() %>">
                      <td><%= index + 1 %></td>
                      <td class="fw-semibold"><%= stock.name %></td>
                      <td><%= stock.company || '-' %></td>
                      <td><span class="badge text-bg-light border"><%= stock.category %></span></td>
                      <td class="text-nowrap"><%= Number(stock.quantity).toLocaleString('en-US') %> <%= stock.type_unit %></td>
                      <td class="text-nowrap"><%= Number(stock.price).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                      <td class="text-nowrap"><%= stock.expires_at || '-' %></td>
                      <td>
                        <% if (stock.current_expired) { %>
                          <span class="badge text-bg-danger">Expired</span>
                        <% } else if (stock.expires_at && stock.expires_at === new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Bangkok' })) { %>
                          <span class="badge text-bg-warning">Expiring today</span>
                        <% } else if (stock.expires_at) { %>
                          <span class="badge text-bg-success">Not expired</span>
                        <% } else if (stock.expires_status === 'expired') { %>
                          <span class="badge text-bg-danger">Expired</span>
                        <% } else { %>
                          <span class="badge text-bg-secondary">No expiry date</span>
                        <% } %>
                      </td>
                      <td class="note-column">
                        <span class="note-text" title="<%= stock.note || '-' %>">
                          <%= stock.note || '-' %>
                        </span>
                      </td>
                      <td class="text-center text-nowrap">
                        <button type="button" class="btn btn-sm btn-outline-primary me-1"
                          data-bs-toggle="modal"
                          data-bs-target="#stockDetailModal"
                          data-stock='<%- JSON.stringify(stock).replace(/'/g, "&#39;") %>'>
                          <i class="fa-solid fa-eye"></i>
                        </button>
                        <a href="/stock/<%= stock.stock_id %>/edit" class="btn btn-sm btn-outline-warning">
                          <i class="fa-solid fa-pen-to-square"></i>
                        </a>
                      </td>
                    </tr>
                  <% }) %>
                  <% if (stocks.length === 0) { %>
                    <tr>
                      <td colspan="10" class="text-center text-muted py-5">
                        <i class="fa-solid fa-box-open fa-3x mb-3 d-block"></i>
                        ยังไม่มีสินค้าในระบบ
                        <div class="mt-3">
                          <a href="/stock/create" class="btn btn-success btn-sm">
                            <i class="fa-solid fa-plus me-1"></i>เพิ่มสินค้าแรก
                          </a>
                        </div>
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
              <p id="stockNoResult" class="text-center text-muted py-3 d-none">ไม่พบสินค้าที่ค้นหา</p>
            </div>
            <div class="text-muted small mt-2">พบ <span id="stockCount"><%= stocks.length %></span> รายการ</div>
          </div>
        </div>

  <div class="modal fade" id="stockDetailModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title fw-bold">
          <i class="fa-solid fa-box-open me-2"></i>รายละเอียดสินค้า
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body p-4">
        <div class="mb-4">
          <div class="d-flex align-items-center gap-3">
            <div class="rounded-3 bg-primary-subtle text-primary p-3">
              <i class="fa-solid fa-box fa-2x"></i>
            </div>
            <div class="min-w-0">
              <h5 class="fw-bold mb-1" id="stockDetailName">-</h5>
              <span class="badge text-bg-light border" id="stockDetailCategory">-</span>
            </div>
          </div>
        </div>

        <div class="mb-4">
          <h6 class="fw-bold text-primary mb-3">
            <i class="fa-solid fa-circle-info me-2"></i>ข้อมูลทั่วไป
          </h6>
          <div class="row g-3" id="stockDetailGeneral"></div>
        </div>

        <hr class="my-4">

        <div class="mb-4">
          <h6 class="fw-bold text-primary mb-3">
            <i class="fa-solid fa-coins me-2"></i>ข้อมูลจำนวนและราคา
          </h6>
          <div class="row g-3" id="stockDetailPrice"></div>
        </div>

        <hr class="my-4">

        <div class="mb-4">
          <h6 class="fw-bold text-primary mb-3">
            <i class="fa-solid fa-calendar-days me-2"></i>ข้อมูลวันหมดอายุ
          </h6>
          <div class="row g-3" id="stockDetailExpiry"></div>
        </div>

        <hr class="my-4">

        <div>
          <h6 class="fw-bold text-primary mb-3">
            <i class="fa-solid fa-note-sticky me-2"></i>หมายเหตุ
          </h6>
          <div id="stockDetailNote" class="stock-detail-note">-</div>
        </div>
      </div>

      <div class="modal-footer bg-light">
        <button type="button" class="btn btn-light border" data-bs-dismiss="modal">
          <i class="fa-solid fa-xmark me-1"></i>ปิด
        </button>
        <a href="#" id="stockEditButton" class="btn btn-warning">
          <i class="fa-solid fa-pen-to-square me-1"></i>แก้ไขสินค้า
        </a>
      </div>
    </div>
  </div>
</div>


      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
  const searchInput = document.getElementById('stockSearch');
  const rows = [...document.querySelectorAll('#stockTableBody tr[data-search]')];
  const countElement = document.getElementById('stockCount');
  const noResult = document.getElementById('stockNoResult');

  searchInput.addEventListener('input', () => {
    const query = searchInput.value.trim().toLowerCase();
    let count = 0;

    rows.forEach(row => {
      const visible = row.dataset.search.includes(query);
      row.classList.toggle('d-none', !visible);

      if (visible) count++;
    });

    countElement.textContent = count;
    noResult.classList.toggle('d-none', count > 0 || rows.length === 0);
  });
</script>

<script>
  const stockDetailModal = document.getElementById('stockDetailModal');
  const stockEditButton = document.getElementById('stockEditButton');

  function createDetailItem(label, value) {
    const column = document.createElement('div');
    column.className = 'col-md-6';

    const item = document.createElement('div');
    item.className = 'stock-detail-item';

    const title = document.createElement('div');
    title.className = 'detail-label';
    title.textContent = label;

    const detail = document.createElement('div');
    detail.className = 'detail-value';
    detail.textContent = value ?? '-';

    item.append(title, detail);
    column.appendChild(item);

    return column;
  }

  function renderDetails(elementId, items) {
    const container = document.getElementById(elementId);
    container.replaceChildren();

    items.forEach(([label, value]) => {
      container.appendChild(createDetailItem(label, value));
    });
  }

  stockDetailModal.addEventListener('show.bs.modal', event => {
    const button = event.relatedTarget;

    let stock;

    try {
      stock = JSON.parse(button.dataset.stock);
    } catch (error) {
      console.error('ไม่สามารถอ่านข้อมูลสินค้าได้:', error);
      return;
    }

    // ข้อมูลหัว Modal
    document.getElementById('stockDetailName').textContent = stock.name || '-';
    document.getElementById('stockDetailCategory').textContent = stock.category || '-';

    // ข้อมูลทั่วไป
    const general = [
      ['บริษัท / ผู้ผลิต', stock.company || '-'],
      ['หมวดหมู่', stock.category || '-'],
      ['หน่วยนับ', stock.type_unit || '-']
    ];

    // จำนวนและราคา
    const price = [
      [
        'จำนวนคงเหลือ',
        `${Number(stock.quantity || 0).toLocaleString('en-US')} ${stock.type_unit || ''}`
      ],
      [
        'ราคาขาย / หน่วย',
        `${Number(stock.price || 0).toLocaleString('en-US', {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2
        })} บาท`
      ],
      [
        'ราคาซื้อ / หน่วย',
        `${Number(stock.buy_unit || 0).toLocaleString('en-US', {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2
        })} บาท`
      ]
    ];

    // สถานะวันหมดอายุ
    let expiryStatus = 'ไม่มีวันหมดอายุ';

    if (stock.current_expired || stock.expires_status === 'expired') {
      expiryStatus = 'Expired';
    } else if (stock.expires_at) {
      const today = new Date().toLocaleDateString('en-CA', {
        timeZone: 'Asia/Bangkok'
      });

      expiryStatus = stock.expires_at === today
        ? 'Expiring today'
        : 'Not expired';
    }

    const expiry = [
      ['วันหมดอายุ', stock.expires_at || 'ไม่มีวันหมดอายุ'],
      ['สถานะ', expiryStatus]
    ];

    // แสดงข้อมูลแต่ละส่วน
    renderDetails('stockDetailGeneral', general);
    renderDetails('stockDetailPrice', price);
    renderDetails('stockDetailExpiry', expiry);

    // หมายเหตุ
    document.getElementById('stockDetailNote').textContent = stock.note || '-';

    // ปุ่มแก้ไขสินค้า
    stockEditButton.href = `/stock/${stock.stock_id}/edit`;
  });
</script>

</body>
</html>
