<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Visit Record Form - WebClinic</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <style>
    body { background: #f5f7fb; }
    .main-content { padding: 28px; }
    .form-card { border: 0; border-radius: 14px; box-shadow: 0 3px 15px rgba(30,50,80,.05); }
    .section-title { color: #315f85; font-weight: 700; }
    .btn-primary { background: #315f85; border-color: #315f85; }
    .btn-primary:hover { background: #244967; border-color: #244967; }
    .info-label { color: #6c757d; font-size: .85rem; margin-bottom: 4px; }
    .info-value { font-weight: 600; overflow-wrap: anywhere; }
    .required-note { font-size: .85rem; color: #6c757d; }
    @media (max-width: 576px) { .main-content { padding: 16px; } }
  </style>
</head>
<body>
  <%- include('../partial/navbar') %>
  <div class="container-fluid">
    <div class="row">
      <%- include('../partial/menu') %>
      <main class="col main-content">
        <div class="mb-4">
          <a href="/visit-records" class="text-decoration-none text-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i> กลับไปหน้า Visit Records
          </a>
          <h2 class="mt-3 fw-bold"><i class="fa-solid fa-clipboard-list text-primary me-2"></i>Visit Record Form</h2>
          <p class="text-secondary mb-0">บันทึกและแก้ไขรายละเอียดการเข้ารับบริการ</p>
        </div>

        <div id="formMessage" aria-live="polite">
          <% if (locals.error) { %>
            <div class="alert alert-danger"><%= error %></div>
          <% } %>
          <% if (locals.success) { %>
            <div class="alert alert-success"><%= success %></div>
          <% } %>
        </div>

        <div class="card form-card p-3 p-md-4 mb-4">
          <h5 class="section-title mb-3"><i class="fa-solid fa-calendar-check me-2"></i>ข้อมูลนัดหมาย</h5>
          <div class="row g-3">
            <div class="col-6 col-md-4">
              <div class="info-label">Appointment ID</div>
              <div class="info-value">#<%= appointment.appointment_id %></div>
            </div>
            <div class="col-6 col-md-4">
              <div class="info-label">สัตว์เลี้ยง</div>
              <div class="info-value"><%= appointment.pets?.pet_name || '-' %></div>
            </div>
            <div class="col-6 col-md-4">
              <div class="info-label">ประเภทนัดหมาย</div>
              <div class="info-value"><%= appointment.type || '-' %></div>
            </div>
            <div class="col-6 col-md-4">
              <div class="info-label">วันที่นัดหมาย</div>
              <div class="info-value"><%= appointment.appointment_date %></div>
            </div>
            <div class="col-6 col-md-4">
              <div class="info-label">เวลานัดหมาย</div>
              <div class="info-value"><%= String(appointment.appointment_time || '').slice(0,5) %></div>
            </div>
            <div class="col-6 col-md-4">
              <div class="info-label">สัตวแพทย์</div>
              <div class="info-value"><%= [appointment.vets?.first_name, appointment.vets?.last_name].filter(Boolean).join(' ') || '-' %></div>
            </div>
            <% if (appointment.title) { %>
              <div class="col-12">
                <div class="info-label">หัวข้อนัดหมาย</div>
                <div class="info-value"><%= appointment.title %></div>
              </div>
            <% } %>
            <% if (appointment.detail) { %>
              <div class="col-12">
                <div class="info-label">รายละเอียดนัดหมาย</div>
                <div class="info-value fw-normal"><%= appointment.detail %></div>
              </div>
            <% } %>
          </div>
        </div>

        <div class="card form-card p-3 p-md-4">
          <h5 class="section-title mb-2"><i class="fa-solid fa-stethoscope me-2"></i>ข้อมูลการเข้ารับบริการ</h5>
          <p class="required-note mb-4">
            <i class="fa-solid fa-circle-info me-1"></i>
            กรุณากรอกข้อมูลทุกช่องที่มีเครื่องหมาย <span class="text-danger">*</span> ให้ครบก่อนบันทึก
          </p>

          <form id="visitRecordForm" action="/visit-records/save/<%= appointment.appointment_id %>" method="POST" novalidate>
            <div class="row g-3">
              <div class="col-md-6">
                <label for="visit_date" class="form-label">วันที่เข้าตรวจ <span class="text-danger">*</span></label>
                <input type="date" id="visit_date" name="visit_date" class="form-control"
                  value="<%= visitRecord?.visit_date || new Date(Date.now() - new Date().getTimezoneOffset() * 60000).toISOString().slice(0,10) %>" required>
                <div class="invalid-feedback">กรุณาระบุวันที่เข้าตรวจ</div>
              </div>

              <div class="col-md-6">
                <label for="visit_time" class="form-label">เวลาเข้าตรวจ <span class="text-danger">*</span></label>
                <input type="time" id="visit_time" name="visit_time" class="form-control"
                  value="<%= visitRecord?.visit_time ? String(visitRecord.visit_time).slice(0,5) : new Date().toTimeString().slice(0,5) %>" required>
                <div class="invalid-feedback">กรุณาระบุเวลาเข้าตรวจ</div>
              </div>

              <div class="col-md-6">
                <label for="weight" class="form-label">น้ำหนัก (kg) <span class="text-danger">*</span></label>
                <input type="number" id="weight" name="weight" class="form-control"
                  min="0.01" max="999999.99" step="0.01" placeholder="เช่น 9.50"
                  value="<%= visitRecord?.weight ?? '' %>" required>
                <div class="invalid-feedback">กรุณาระบุน้ำหนักที่มากกว่า 0 และไม่เกิน 999999.99 kg</div>
              </div>

              <div class="col-12">
                <label for="symptoms" class="form-label">Symptoms / อาการ <span class="text-danger">*</span></label>
                <textarea id="symptoms" name="symptoms" class="form-control" rows="3" placeholder="ระบุอาการที่พบ" required><%= visitRecord?.symptoms || '' %></textarea>
                <div class="invalid-feedback">กรุณาระบุอาการของสัตว์เลี้ยง</div>
              </div>

              <div class="col-12">
                <label for="diagnosis" class="form-label">Diagnosis / การวินิจฉัย <span class="text-danger">*</span></label>
                <textarea id="diagnosis" name="diagnosis" class="form-control" rows="3" placeholder="ระบุผลการวินิจฉัย" required><%= visitRecord?.diagnosis || '' %></textarea>
                <div class="invalid-feedback">กรุณาระบุผลการวินิจฉัย</div>
              </div>

              <div class="col-12">
                <label for="treatment" class="form-label">Treatment / การรักษา <span class="text-danger">*</span></label>
                <textarea id="treatment" name="treatment" class="form-control" rows="3" placeholder="ระบุวิธีการรักษา" required><%= visitRecord?.treatment || '' %></textarea>
                <div class="invalid-feedback">กรุณาระบุวิธีการรักษา</div>
              </div>

              <div class="col-12">
                <label for="note" class="form-label">Note / หมายเหตุ <span class="text-danger">*</span></label>
                <textarea id="note" name="note" class="form-control" rows="3" placeholder="คำแนะนำหรือรายละเอียดเพิ่มเติม หากไม่มีให้ระบุว่า ไม่มี" required><%= visitRecord?.note || '' %></textarea>
                <div class="invalid-feedback">กรุณาระบุหมายเหตุ หรือพิมพ์ว่า ไม่มี</div>
              </div>
            </div>

            <div class="d-flex flex-wrap justify-content-end gap-2 mt-4">
              <a href="/visit-records" class="btn btn-outline-secondary">กลับ</a>
              <button type="submit" class="btn btn-primary" id="saveButton">
                <i class="fa-solid fa-floppy-disk me-1"></i>
                <%= visitRecord ? 'บันทึกการแก้ไข' : 'ยืนยันและบันทึกผลตรวจ' %>
              </button>
            </div>
          </form>
        </div>
      </main>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('visitRecordForm');
      const message = document.getElementById('formMessage');
      const saveButton = document.getElementById('saveButton');
      const fields = [...form.querySelectorAll('[required]')];
      const originalButtonHtml = saveButton.innerHTML;

      function showMessage(text, success = false) {
        message.replaceChildren();
        const alert = document.createElement('div');
        alert.className = `alert alert-${success ? 'success' : 'danger'}`;
        alert.setAttribute('role', 'alert');
        alert.textContent = text;
        message.appendChild(alert);
        message.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      fields.forEach(field => {
        field.addEventListener('input', () => {
          field.classList.remove('is-invalid');
          field.setCustomValidity('');
        });
        field.addEventListener('change', () => {
          field.classList.remove('is-invalid');
        });
      });

      form.addEventListener('submit', async event => {
        event.preventDefault();

        let firstInvalid = null;

        fields.forEach(field => {
          const empty = !String(field.value || '').trim();
          const invalidWeight = field.name === 'weight' &&
            (empty || !Number.isFinite(Number(field.value)) ||
             Number(field.value) <= 0 || Number(field.value) > 999999.99);
          const invalid = empty || invalidWeight || !field.checkValidity();

          field.classList.toggle('is-invalid', invalid);

          if (invalid && !firstInvalid) {
            firstInvalid = field;
          }
        });

        if (firstInvalid) {
          showMessage('กรุณากรอกข้อมูลการเข้ารับบริการให้ครบทุกช่องและตรวจสอบค่าที่ระบุ');
          firstInvalid.focus();
          return;
        }

        saveButton.disabled = true;
        saveButton.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>กำลังบันทึก...';

        try {
          const formData = new URLSearchParams();

          new FormData(form).forEach((value, key) => {
            formData.append(key, String(value));
          });

          console.log('Form action:', form.action);
          console.log('Form method:', 'POST');
          console.log('Form data:', Object.fromEntries(formData.entries()));

          const response = await fetch(form.action, {
            method: 'POST',
            body: formData.toString(),
            headers: {
              'Accept': 'application/json',
              'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
              'X-Requested-With': 'XMLHttpRequest'
            }
          });

          const contentType = response.headers.get('content-type') || '';
          let result;

          if (contentType.includes('application/json')) {
            result = await response.json();
          } else {
            const responseText = await response.text();
            console.error('Unexpected server response:', responseText);
            throw new Error(`เซิร์ฟเวอร์ตอบกลับในรูปแบบที่ไม่คาดหมาย (HTTP ${response.status})`);
          }

          console.log('Response status:', response.status);
          console.log('Response body:', result);

          if (!response.ok || !result.success) {
            showMessage(result.message || 'บันทึกข้อมูลไม่สำเร็จ กรุณาตรวจสอบข้อมูล');
            return;
          }

          showMessage(result.message || 'บันทึกข้อมูลเรียบร้อยแล้ว', true);

          if (result.visitRecord) {
            Object.entries(result.visitRecord).forEach(([key, value]) => {
              const field = form.elements.namedItem(key);
              if (field && value != null) {
                field.value = key === 'visit_time' ? String(value).slice(0, 5) : value;
              }
            });
          }

          saveButton.innerHTML = '<i class="fa-solid fa-check me-1"></i>บันทึกแล้ว';

          const url = new URL(window.location.href);
          url.searchParams.set('success', result.message || 'บันทึกข้อมูลเรียบร้อยแล้ว');
          window.history.replaceState({}, '', url);
        } catch (error) {
          console.error('Visit record submission error:', error);
          showMessage(error.message || 'ไม่สามารถส่งข้อมูลได้ กรุณาลองใหม่อีกครั้ง');
        } finally {
          saveButton.disabled = false;
          if (saveButton.textContent.includes('กำลังบันทึก')) {
            saveButton.innerHTML = originalButtonHtml;
          }
        }
      });
    });
  </script>
</body>
</html>
