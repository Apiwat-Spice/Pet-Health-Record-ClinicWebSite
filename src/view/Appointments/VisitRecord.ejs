
<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Visit Records - WebClinic</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <style>
    body { background: #f5f7fb; }
    main { min-width: 0; }
    .page-title { color: #24364b; font-weight: 700; }
    .content-card { border: 0; border-radius: 14px; box-shadow: 0 3px 15px rgba(30,50,80,.05); }
    .btn-primary { background: #315f85; border-color: #315f85; }
    .btn-primary:hover { background: #244967; border-color: #244967; }
    .filter-row { display: flex; align-items: center; gap: 12px; }
    .search-box { flex: 0 0 75%; min-width: 0; }
    .type-filter { flex: 0 0 calc(25% - 12px); min-width: 0; }
    .table th { white-space: nowrap; }
    .table td { vertical-align: middle; }
    .pet-name { font-weight: 600; }
    @media (max-width: 767px) {
      main { padding: 1rem !important; }
      .filter-row { flex-wrap: wrap; }
      .search-box, .type-filter { flex: 1 1 100%; }
    }
  </style>
</head>
<body>
  <%- include('../partial/navbar') %>
  <div class="container-fluid">
    <div class="row">
      <%- include('../partial/menu') %>
      <main class="col-md-9 col-lg-10 p-4">
        <div class="mb-4">
          <h2 class="page-title mb-1">
            <i class="fa-solid fa-clipboard-list text-primary me-2"></i>Visit Records
          </h2>
          <p class="text-secondary mb-0">จัดการข้อมูลการเข้ารับบริการและผลตรวจสัตว์เลี้ยง</p>
        </div>

        <% if (locals.success) { %>
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i><%= success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="ปิด"></button>
          </div>
        <% } %>
        <% if (locals.error) { %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i><%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="ปิด"></button>
          </div>
        <% } %>

        <section>
          <div class="card content-card">
            <div class="card-body p-3 p-md-4">
              <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                <div class="btn-group flex-wrap" role="group" aria-label="กรองสถานะ Visit Record">
                  <button type="button" class="btn btn-primary status-toggle" data-status="pending">
                    <i class="fa-solid fa-clock me-1"></i>รอบันทึก
                    <span class="badge text-bg-light ms-1"><%= appointments.filter(a => !a.visit_record).length %></span>
                  </button>
                  <button type="button" class="btn btn-outline-primary status-toggle" data-status="done">
                    <i class="fa-solid fa-clipboard-check me-1"></i>บันทึกแล้ว
                    <span class="badge text-bg-secondary ms-1"><%= appointments.filter(a => !!a.visit_record).length %></span>
                  </button>
                </div>

                <div class="filter-row flex-grow-1" style="max-width: 620px;">
                  <div class="search-box">
                    <div class="input-group">
                      <span class="input-group-text bg-white">
                        <i class="fa-solid fa-magnifying-glass"></i>
                      </span>
                      <input type="search" id="visitRecordSearch" class="form-control" placeholder="ค้นหาสัตว์เลี้ยง เจ้าของ หรือสัตวแพทย์">
                    </div>
                  </div>
                  <div class="type-filter">
                    <select id="visitTypeFilter" class="form-select" aria-label="กรองประเภทนัดหมาย">
                      <option value="">ทุกประเภท</option>
                      <option value="Walk-in">Walk-in</option>
                      <option value="Follow-up">Follow-up</option>
                    </select>
                  </div>
                </div>
              </div>

              <% ['pending', 'done'].forEach(group => { %>
                <% const filtered = appointments.filter(a => group === 'done' ? !!a.visit_record : !a.visit_record); %>
                <div class="visit-group <%= group === 'pending' ? '' : 'd-none' %>" data-group="<%= group %>">
                  <% if (!filtered.length) { %>
                    <div class="empty-state text-center text-secondary py-5">
                      <i class="fa-regular fa-calendar-xmark fa-3x mb-3"></i>
                      <p class="mb-0"><%= group === 'pending' ? 'ไม่มีนัดหมายที่รอบันทึกผลตรวจ' : 'ยังไม่มี Visit Record ที่บันทึกแล้ว' %></p>
                    </div>
                  <% } else { %>
                    <div class="table-responsive">
                      <table class="table table-hover align-middle">
                        <thead class="table-light">
                          <tr>
                            <th>วันและเวลา</th>
                            <th>สัตว์เลี้ยง</th>
                            <th>เจ้าของ</th>
                            <th>หัวข้อ / ประเภท</th>
                            <th>สัตวแพทย์</th>
                            <th>สถานะ</th>
                            <th>จัดการ</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% filtered.forEach(a => { %>
                            <tr
                              data-search="<%= [a.appointment_id, a.pet_name, a.owner_name, a.vet_name, a.title, a.detail, a.type].filter(Boolean).join(' ').toLowerCase() %>"
                              data-type="<%= a.type || '' %>">
                              <td class="text-nowrap">
                                <div class="fw-semibold"><%= a.appointment_date || '-' %></div>
                                <small class="text-muted"><%= String(a.appointment_time || '').slice(0, 5) %></small>
                              </td>
                              <td>
                                <div class="pet-name">
                                  <i class="fa-solid fa-paw text-primary me-1"></i><%= a.pet_name || '-' %>
                                </div>
                                <small class="text-muted">Appointment #<%= a.appointment_id %></small>
                              </td>
                              <td><%= a.owner_name || '-' %></td>
                              <td>
                                <div><%= a.title || '-' %></div>
                                <small class="text-muted"><%= a.type || 'ไม่ระบุประเภท' %></small>
                              </td>
                              <td><%= a.vet_name || '-' %></td>
                              <td>
                                <% if (a.visit_record) { %>
                                  <span class="badge text-bg-success">บันทึกแล้ว</span>
                                <% } else { %>
                                  <span class="badge text-bg-primary">รอบันทึก</span>
                                <% } %>
                              </td>
                              <td class="text-nowrap">
                                <a class="btn btn-sm <%= a.visit_record ? 'btn-outline-primary' : 'btn-primary' %>"
                                  href="/visit-records/form/<%= a.appointment_id %>">
                                  <i class="fa-solid <%= a.visit_record ? 'fa-pen-to-square' : 'fa-clipboard-check' %> me-1"></i>
                                  <%= a.visit_record ? 'แก้ไขผลตรวจ' : 'เริ่มบันทึก' %>
                                </a>
                              </td>
                            </tr>
                          <% }) %>
                        </tbody>
                      </table>
                    </div>
                  <% } %>
                </div>
              <% }) %>

              <p id="noVisitRecordResult" class="text-center text-muted py-3 d-none">
                <i class="fa-solid fa-magnifying-glass me-1"></i>ไม่พบรายการที่ตรงกับการค้นหา
              </p>
            </div>
          </div>
        </section>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('visitRecordSearch');
      const typeFilter = document.getElementById('visitTypeFilter');
      const statusButtons = document.querySelectorAll('.status-toggle');
      const groups = document.querySelectorAll('.visit-group');
      const noResult = document.getElementById('noVisitRecordResult');

      function filterVisitRecords() {
        const query = searchInput.value.trim().toLowerCase();
        const type = typeFilter.value;
        const currentGroup = document.querySelector('.visit-group:not(.d-none)');

        if (!currentGroup) {
          noResult.classList.add('d-none');
          return;
        }

        const rows = currentGroup.querySelectorAll('tbody tr');
        let shown = 0;

        rows.forEach(row => {
          const matchSearch = (row.dataset.search || '').includes(query);
          const matchType = !type || row.dataset.type === type;
          const visible = matchSearch && matchType;

          row.classList.toggle('d-none', !visible);
          if (visible) shown++;
        });

        noResult.classList.toggle(
          'd-none',
          rows.length === 0 || shown > 0
        );
      }

      statusButtons.forEach(button => {
        button.addEventListener('click', () => {
          statusButtons.forEach(item => {
            const active = item === button;
            item.classList.toggle('btn-primary', active);
            item.classList.toggle('btn-outline-primary', !active);
            item.querySelector('.badge').classList.toggle('text-bg-light', active);
            item.querySelector('.badge').classList.toggle('text-bg-secondary', !active);
          });

          groups.forEach(group => {
            group.classList.toggle('d-none', group.dataset.group !== button.dataset.status);
          });

          filterVisitRecords();
        });
      });

      searchInput.addEventListener('input', filterVisitRecords);
      typeFilter.addEventListener('change', filterVisitRecords);
      filterVisitRecords();
    });
  </script>
</body>
</html>
