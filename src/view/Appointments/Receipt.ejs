
<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Receipt - WebClinic</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <style>
    body { background: #f5f7fb; }
    main { min-width: 0; }
    .page-title { color: #24364b; font-weight: 700; }
    .content-card { border: 0; border-radius: 14px; box-shadow: 0 3px 15px rgba(30,50,80,.05); }
    .btn-primary { background: #315f85; border-color: #315f85; }
    .btn-primary:hover { background: #244967; border-color: #244967; }
    .table th { white-space: nowrap; }
    .table td { vertical-align: middle; }
    .summary-box { background: #f1f6fa; border-radius: 12px; }
    .money { font-variant-numeric: tabular-nums; }
    @media (max-width: 767px) {
      main { padding: 1rem !important; }
    }
  </style>
</head>
<body>
  <%- include('../partial/navbar') %>
  <div class="container-fluid">
    <div class="row">
      <%- include('../partial/menu') %>
      <main class="col-md-9 col-lg-10 p-4">
        <div class="mb-4">
          <h2 class="page-title mb-1"><i class="fa-solid fa-receipt text-primary me-2"></i>Receipt</h2>
          <p class="text-secondary mb-0">จัดการใบเสร็จ รายการสินค้า และสถานะการชำระเงิน</p>
        </div>

        <% if (locals.success) { %>
          <div class="alert alert-success alert-dismissible fade show">
            <i class="fa-solid fa-circle-check me-2"></i><%= success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>
        <% if (locals.error) { %>
          <div class="alert alert-danger alert-dismissible fade show">
            <i class="fa-solid fa-circle-exclamation me-2"></i><%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>

        <section class="card content-card mb-4">
          <div class="card-body p-3 p-md-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
              <h5 class="mb-0"><i class="fa-solid fa-file-invoice me-2 text-primary"></i><%= selectedTransaction ? 'แก้ไข Receipt' : 'สร้าง Receipt' %></h5>
              <% if (selectedTransaction) { %>
                <span class="badge text-bg-info">Transaction #<%= selectedTransaction.transaction_id %></span>
              <% } %>
            </div>

            <% if (!visits.length) { %>
              <div class="text-center text-secondary py-5">
                <i class="fa-regular fa-folder-open fa-3x mb-3"></i>
                <h6>ยังไม่มี Visit Record ที่พร้อมออก Receipt</h6>
                <p class="mb-0">ต้องมี Visit Record และ Appointment สถานะ Completed ก่อน</p>
              </div>
            <% } else { %>
              <div class="mb-4">
                <label for="visitSelector" class="form-label fw-semibold">เลือก Visit Record <span class="text-danger">*</span></label>
                <select id="visitSelector" class="form-select">
                  <% visits.forEach(v => { %>
                    <% const appt = v.appointment || {}; %>
                    <option value="<%= v.visit_id %>" <%= String(v.visit_id) === String(selectedVisitId) ? 'selected' : '' %>>
                      Visit #<%= v.visit_id %> — <%= v.pet_name %> — <%= v.visit_date %>
                      <%= v.transaction ? '(มี Transaction แล้ว)' : '(ยังไม่มี Receipt)' %>
                    </option>
                  <% }) %>
                </select>
                <div class="form-text">เลือกเฉพาะ Visit Record ที่ Appointment มีสถานะ Completed</div>
              </div>

              <% if (selectedVisit) { %>
                <% const appt = selectedVisit.appointment || {}; %>
                <div class="summary-box p-3 mb-4">
                  <div class="row g-3">
                    <div class="col-md-3">
                      <small class="text-secondary d-block">Visit Record</small>
                      <strong>#<%= selectedVisit.visit_id %></strong>
                    </div>
                    <div class="col-md-3">
                      <small class="text-secondary d-block">สัตว์เลี้ยง</small>
                      <strong><%= selectedVisit.pet_name %></strong>
                    </div>
                    <div class="col-md-3">
                      <small class="text-secondary d-block">วันที่เข้ารับบริการ</small>
                      <strong><%= selectedVisit.visit_date %></strong>
                    </div>
                    <div class="col-md-3">
                      <small class="text-secondary d-block">Appointment</small>
                      <strong>#<%= selectedVisit.appointment_id %> — <%= appt.title || '-' %></strong>
                    </div>
                    <div class="col-md-6">
                      <small class="text-secondary d-block">Diagnosis</small>
                      <span><%= selectedVisit.diagnosis || '-' %></span>
                    </div>
                    <div class="col-md-6">
                      <small class="text-secondary d-block">Treatment</small>
                      <span><%= selectedVisit.treatment || '-' %></span>
                    </div>
                  </div>
                </div>

                <form action="/receipt/save" method="POST" id="receiptForm">
                  <input type="hidden" name="visit_id" value="<%= selectedVisit.visit_id %>">
                  <input type="hidden" name="items_json" id="itemsJson">

                  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                    <h6 class="mb-0">รายการสินค้า</h6>
                    <button type="button" id="addItemBtn" class="btn btn-sm btn-outline-primary">
                      <i class="fa-solid fa-plus me-1"></i>เพิ่มสินค้า
                    </button>
                  </div>

                  <div class="table-responsive">
                    <table class="table table-bordered align-middle">
                      <thead class="table-light">
                        <tr>
                          <th style="min-width:230px">สินค้า</th>
                          <th style="min-width:100px">คงเหลือ</th>
                          <th style="min-width:100px">จำนวน</th>
                          <th style="min-width:140px">ราคาต่อหน่วย</th>
                          <th style="min-width:130px">รวม</th>
                          <th style="width:60px">ลบ</th>
                        </tr>
                      </thead>
                      <tbody id="itemsTableBody"></tbody>
                    </table>
                  </div>

                  <div id="emptyItems" class="text-center text-secondary py-3 d-none">
                    ยังไม่มีรายการสินค้า กด “เพิ่มสินค้า” เพื่อเริ่มต้น
                  </div>

                  <div class="row justify-content-end mt-3">
                    <div class="col-md-5 col-lg-4">
                      <div class="summary-box p-3">
                        <div class="d-flex justify-content-between align-items-center">
                          <span class="fw-semibold">ยอดรวมทั้งหมด</span>
                          <h4 class="mb-0 text-primary money">฿<span id="grandTotal">0.00</span></h4>
                        </div>
                        <small class="text-secondary">คำนวณจากจำนวนสินค้า × ราคาต่อหน่วย</small>
                      </div>
                    </div>
                  </div>

                  <div class="d-flex justify-content-end gap-2 mt-4">
                    <a href="/receipt" class="btn btn-outline-secondary">ล้างการเลือก</a>
                    <button type="submit" class="btn btn-primary" id="saveReceiptBtn">
                      <i class="fa-solid fa-floppy-disk me-1"></i>
                      <%= selectedTransaction ? 'บันทึกการแก้ไข' : 'สร้าง Receipt' %>
                    </button>
                  </div>
                </form>
              <% } %>
            <% } %>
          </div>
        </section>

        <section class="card content-card">
          <div class="card-body p-3 p-md-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
              <h5 class="mb-0"><i class="fa-solid fa-list-check text-primary me-2"></i>Receipt ทั้งหมด</h5>
              <span class="badge text-bg-secondary"><%= receipts.length %> รายการ</span>
            </div>

            <% if (!receipts.length) { %>
              <div class="text-center text-secondary py-4">
                <i class="fa-regular fa-clipboard fa-2x mb-2"></i>
                <p class="mb-0">ยังไม่มี Receipt</p>
              </div>
            <% } else { %>
              <div class="table-responsive">
                <table class="table table-hover align-middle">
                  <thead class="table-light">
                    <tr>
                      <th>Receipt</th>
                      <th>Visit Record</th>
                      <th>สัตว์เลี้ยง</th>
                      <th>รายการสินค้า</th>
                      <th>ยอดรวม</th>
                      <th>สถานะ</th>
                      <th>จัดการ</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% receipts.forEach(r => { %>
                      <tr>
                        <td>
                          <strong>#<%= r.receipt_id %></strong>
                          <small class="d-block text-secondary">Transaction #<%= r.transaction.transaction_id %></small>
                        </td>
                        <td>
                          <a href="/receipt?visit_id=<%= r.visit.visit_id %>">#<%= r.visit.visit_id %></a>
                          <small class="d-block text-secondary"><%= r.visit.visit_date %></small>
                        </td>
                        <td><%= r.visit.pet_name %></td>
                        <td>
                          <% if (r.items.length) { %>
                            <% r.items.forEach(item => { %>
                              <div><%= item.stock_name %> × <%= item.quantity %></div>
                            <% }) %>
                          <% } else { %>
                            <span class="text-secondary">ไม่มีรายการสินค้า</span>
                          <% } %>
                        </td>
                        <td class="text-nowrap money">฿<%= Number(r.transaction.total_price || 0).toFixed(2) %></td>
                        <td>
                          <% if (r.payment_status === 'paid') { %>
                            <span class="badge text-bg-success">จ่ายแล้ว</span>
                          <% } else if (r.payment_status === 'cancelled') { %>
                            <span class="badge text-bg-danger">ยกเลิก</span>
                          <% } else { %>
                            <span class="badge text-bg-warning">ยังไม่จ่าย</span>
                          <% } %>
                        </td>
                        <td class="text-nowrap">
                          <a href="/receipt?visit_id=<%= r.visit.visit_id %>" class="btn btn-sm btn-outline-primary mb-1">
                            <i class="fa-solid fa-pen-to-square me-1"></i>แก้ไข
                          </a>
                          <% if (r.payment_status !== 'cancelled') { %>
                            <button
                              type="button"
                              class="btn btn-sm <%= r.payment_status === 'paid' ? 'btn-outline-warning' : 'btn-outline-success' %> payment-button mb-1"
                              data-receipt-id="<%= r.receipt_id %>"
                              data-current="<%= r.payment_status %>"
                              data-bs-toggle="modal"
                              data-bs-target="#paymentModal">
                              <i class="fa-solid <%= r.payment_status === 'paid' ? 'fa-rotate-left' : 'fa-check' %> me-1"></i>
                              <%= r.payment_status === 'paid' ? 'เปลี่ยนเป็นยังไม่จ่าย' : 'ยืนยันจ่ายแล้ว' %>
                            </button>
                          <% } %>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </div>
        </section>
      </main>
    </div>
  </div>

  <div class="modal fade" id="paymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <form method="POST" id="paymentForm">
          <div class="modal-header">
            <h5 class="modal-title"><i class="fa-solid fa-money-bill-wave text-primary me-2"></i>ยืนยันสถานะชำระเงิน</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <p id="paymentConfirmText" class="mb-2"></p>
            <div class="alert alert-warning mb-0">
              <i class="fa-solid fa-circle-info me-1"></i>เป็นการจำลองสถานะเท่านั้น ไม่มีการรับชำระเงินจริง
            </div>
            <input type="hidden" name="payment_status" id="nextPaymentStatus">
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">ยกเลิก</button>
            <button type="submit" class="btn btn-primary">ยืนยัน</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const stockData = <%- JSON.stringify(stocks).replace(/</g, '\\u003c') %>;
    const initialItems = <%- JSON.stringify(selectedItems).replace(/</g, '\\u003c') %>;
    const tableBody = document.getElementById('itemsTableBody');
    const emptyItems = document.getElementById('emptyItems');
    const totalElement = document.getElementById('grandTotal');
    const itemsJson = document.getElementById('itemsJson');
    const receiptForm = document.getElementById('receiptForm');

    document.getElementById('visitSelector')?.addEventListener('change', function () {
      window.location.href = '/receipt?visit_id=' + encodeURIComponent(this.value);
    });

    function money(value) {
      return Number(value || 0).toLocaleString('th-TH', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });
    }

    function getStock(stockId) {
      return stockData.find(stock => String(stock.stock_id) === String(stockId));
    }

    function createCell(className) {
      const td = document.createElement('td');
      if (className) td.className = className;
      return td;
    }

    function updateTotals() {
      let total = 0;
      tableBody.querySelectorAll('tr').forEach(row => {
        const quantity = Number(row.querySelector('.item-quantity').value);
        const price = Number(row.querySelector('.item-price').value);
        const subtotal = quantity > 0 && price >= 0 ? quantity * price : 0;
        row.querySelector('.item-subtotal').textContent = money(subtotal);
        total += subtotal;
      });
      totalElement.textContent = money(total);
      emptyItems.classList.toggle('d-none', tableBody.children.length > 0);
    }

    function updateStockOptions() {
      const rows = [...tableBody.querySelectorAll('tr')];
      const selectedIds = rows.map(row => row.querySelector('.item-stock').value).filter(Boolean);

      rows.forEach(row => {
        const select = row.querySelector('.item-stock');
        [...select.options].forEach(option => {
          if (!option.value) return;
          option.disabled = selectedIds.includes(option.value) && option.value !== select.value;
        });
      });
    }

    function addItem(item = {}) {
      const row = document.createElement('tr');

      const stockCell = createCell();
      const stockSelect = document.createElement('select');
      stockSelect.className = 'form-select item-stock';
      stockSelect.required = true;

      const placeholder = document.createElement('option');
      placeholder.value = '';
      placeholder.textContent = 'เลือกสินค้า';
      stockSelect.appendChild(placeholder);

      stockData.forEach(stock => {
        const option = document.createElement('option');
        option.value = stock.stock_id;
        option.textContent = `${stock.name} — คงเหลือ ${stock.quantity} ${stock.type_unit || ''}${stock.expires_status === 'expired' ? ' (หมดอายุ)' : ''}`;
        if (String(stock.stock_id) === String(item.stock_id)) option.selected = true;
        stockSelect.appendChild(option);
      });

      stockCell.appendChild(stockSelect);
      row.appendChild(stockCell);

      const quantityCell = createCell();
      const stockQuantity = document.createElement('div');
      stockQuantity.className = 'small text-secondary stock-quantity';
      quantityCell.appendChild(stockQuantity);
      row.appendChild(quantityCell);

      const qtyCell = createCell();
      const qtyInput = document.createElement('input');
      qtyInput.type = 'number';
      qtyInput.min = '1';
      qtyInput.step = '1';
      qtyInput.required = true;
      qtyInput.value = item.quantity || 1;
      qtyInput.className = 'form-control item-quantity';
      qtyCell.appendChild(qtyInput);
      row.appendChild(qtyCell);

      const priceCell = createCell();
      const priceInput = document.createElement('input');
      priceInput.type = 'number';
      priceInput.min = '0';
      priceInput.step = '0.01';
      priceInput.required = true;
      priceInput.value = item.unit_price ?? '';
      priceInput.className = 'form-control item-price';
      priceCell.appendChild(priceInput);
      row.appendChild(priceCell);

      const subtotalCell = createCell('text-end text-nowrap money');
      subtotalCell.innerHTML = '฿<span class="item-subtotal">0.00</span>';
      row.appendChild(subtotalCell);

      const removeCell = createCell('text-center');
      const removeButton = document.createElement('button');
      removeButton.type = 'button';
      removeButton.className = 'btn btn-sm btn-outline-danger';
      removeButton.innerHTML = '<i class="fa-solid fa-trash"></i>';
      removeButton.setAttribute('aria-label', 'ลบรายการสินค้า');
      removeButton.addEventListener('click', () => {
        row.remove();
        updateStockOptions();
        updateTotals();
      });
      removeCell.appendChild(removeButton);
      row.appendChild(removeCell);

      function refreshStock() {
        const stock = getStock(stockSelect.value);
        stockQuantity.textContent = stock
          ? `${stock.quantity} ${stock.type_unit || ''}`
          : '-';

        if (stock && item.unit_price == null && !priceInput.dataset.edited) {
          priceInput.value = Number(stock.price || 0).toFixed(2);
        }
        updateStockOptions();
        updateTotals();
      }

      stockSelect.addEventListener('change', () => {
        item.unit_price = null;
        delete priceInput.dataset.edited;
        refreshStock();
      });
      priceInput.addEventListener('input', () => {
        priceInput.dataset.edited = '1';
        updateTotals();
      });
      qtyInput.addEventListener('input', updateTotals);

      tableBody.appendChild(row);
      refreshStock();
    }

    document.getElementById('addItemBtn')?.addEventListener('click', () => addItem());

    if (tableBody && receiptForm) {
      initialItems.forEach(item => addItem(item));
      updateTotals();

      receiptForm.addEventListener('submit', event => {
        const rows = [...tableBody.querySelectorAll('tr')];
        if (!rows.length) {
          event.preventDefault();
          alert('กรุณาเพิ่มสินค้าอย่างน้อย 1 รายการ');
          return;
        }

        const items = [];
        for (const row of rows) {
          const stockId = Number(row.querySelector('.item-stock').value);
          const quantity = Number(row.querySelector('.item-quantity').value);
          const unitPrice = Number(row.querySelector('.item-price').value);
          const stock = getStock(stockId);

          if (!stock || !Number.isSafeInteger(quantity) || quantity <= 0 ||
              !Number.isFinite(unitPrice) || unitPrice < 0) {
            event.preventDefault();
            alert('กรุณาตรวจสอบสินค้า จำนวน และราคาต่อหน่วยให้ถูกต้อง');
            return;
          }

          items.push({
            stock_id: stockId,
            quantity,
            unit_price: Math.round(unitPrice * 100) / 100
          });
        }

        if (new Set(items.map(item => item.stock_id)).size !== items.length) {
          event.preventDefault();
          alert('ไม่สามารถเลือกสินค้าชนิดเดียวกันซ้ำหลายแถวได้');
          return;
        }

        itemsJson.value = JSON.stringify(items);
        document.getElementById('saveReceiptBtn').disabled = true;
      });
    }

    document.querySelectorAll('.payment-button').forEach(button => {
      button.addEventListener('click', () => {
        const receiptId = button.dataset.receiptId;
        const current = button.dataset.current;
        const next = current === 'paid' ? 'pending' : 'paid';

        document.getElementById('paymentForm').action = `/receipt/payment/${receiptId}`;
        document.getElementById('nextPaymentStatus').value = next;
        document.getElementById('paymentConfirmText').textContent = next === 'paid'
          ? `ยืนยันเปลี่ยน Receipt #${receiptId} เป็นสถานะ “จ่ายแล้ว” หรือไม่?`
          : `ยืนยันเปลี่ยน Receipt #${receiptId} กลับเป็น “ยังไม่จ่าย” หรือไม่?`;
      });
    });
  </script>
</body>
</html>
