
<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Receipt - WebClinic</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <style>
    body { background: #f8f9fa; }
    main { min-width: 0; }
    .content-card { border: 0; border-radius: 12px; box-shadow: 0 .125rem .5rem rgba(0,0,0,.06); }
    .page-title { color: #24364b; font-weight: 700; }
    .btn-primary { background: #315f85; border-color: #315f85; }
    .btn-primary:hover { background: #244967; border-color: #244967; }
    .table th { white-space: nowrap; }
    .table td { vertical-align: middle; }
    .money { font-variant-numeric: tabular-nums; }
    .status-toggle { white-space: nowrap; }
    @media (max-width: 576px) {
      main { padding: 1rem !important; }
    }
  </style>
</head>
<body>
  <%- include('../partial/navbar') %>
  <div class="container-fluid">
    <div class="row">
      <%- include('../partial/menu') %>
      <main class="col-md-9 col-lg-10 p-4">
        <div class="mb-4">
          <h2 class="page-title mb-1"><i class="fa-solid fa-receipt text-primary me-2"></i>Receipt</h2>
          <p class="text-muted mb-0">จัดการใบเสร็จและสถานะการชำระเงิน</p>
        </div>

        <% if (locals.success) { %>
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i><%= success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>
        <% if (locals.error) { %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i><%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>

        <section class="card content-card mb-4">
          <div class="card-body p-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
              <div class="btn-group flex-wrap" role="group" aria-label="Receipt navigation">
                <a href="/receipt" class="btn btn-primary">
                  <i class="fa-solid fa-list-check me-1"></i>Receipt ทั้งหมด
                  <span class="badge text-bg-light ms-1"><%= receipts.length %></span>
                </a>
                <a href="/receipt/create" class="btn btn-outline-primary">
                  <i class="fa-solid fa-plus me-1"></i>สร้าง Receipt
                </a>
              </div>
              <div class="input-group" style="max-width: 320px;">
                <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass"></i></span>
                <input type="search" id="receiptSearch" class="form-control" placeholder="ค้นหา Receipt หรือสัตว์เลี้ยง">
              </div>
            </div>
          </div>
        </section>

        <section class="card content-card">
          <div class="card-body p-3 p-md-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
              <h5 class="mb-0"><i class="fa-solid fa-file-invoice text-primary me-2"></i>Receipt ทั้งหมด</h5>
              <div class="btn-group flex-wrap" role="group" aria-label="Filter payment status">
                <button type="button" class="btn btn-primary status-toggle" data-status="all">
                  ทั้งหมด <span class="badge text-bg-light ms-1"><%= receipts.length %></span>
                </button>
                <button type="button" class="btn btn-outline-primary status-toggle" data-status="pending">
                  Pending <span class="badge text-bg-secondary ms-1"><%= receipts.filter(r => r.payment_status === 'pending').length %></span>
                </button>
                <button type="button" class="btn btn-outline-primary status-toggle" data-status="paid">
                  Paid <span class="badge text-bg-secondary ms-1"><%= receipts.filter(r => r.payment_status === 'paid').length %></span>
                </button>
                <button type="button" class="btn btn-outline-primary status-toggle" data-status="cancelled">
                  Cancelled <span class="badge text-bg-secondary ms-1"><%= receipts.filter(r => r.payment_status === 'cancelled').length %></span>
                </button>
              </div>
            </div>

            <% if (!receipts.length) { %>
              <div class="text-center text-muted py-5">
                <i class="fa-regular fa-clipboard fa-3x mb-3"></i>
                <h6>ยังไม่มี Receipt</h6>
                <p>เริ่มต้นสร้างใบเสร็จจาก Visit Record ที่พร้อมออกใบเสร็จ</p>
                <a href="/receipt/create" class="btn btn-primary">
                  <i class="fa-solid fa-plus me-1"></i>สร้าง Receipt
                </a>
              </div>
            <% } else { %>
              <div class="table-responsive">
                <table class="table table-hover align-middle">
                  <thead class="table-light">
                    <tr>
                      <th>Receipt</th>
                      <th>Visit Record</th>
                      <th>สัตว์เลี้ยง</th>
                      <th>รายการสินค้า</th>
                      <th>ยอดรวม</th>
                      <th>สถานะ</th>
                      <th>วันที่สร้าง</th>
                      <th>จัดการ</th>
                    </tr>
                  </thead>
                  <tbody id="receiptTableBody">
                    <% receipts.forEach(r => { %>
                      <tr data-status="<%= r.payment_status %>"
                          data-search="<%= [r.receipt_id, r.transaction.transaction_id, r.visit.visit_id, r.visit.pet_name, ...r.items.map(i => i.stock_name)].join(' ').toLowerCase() %>">
                        <td>
                          <strong>#<%= r.receipt_id %></strong>
                          <small class="d-block text-muted">Transaction #<%= r.transaction.transaction_id %></small>
                        </td>
                        <td>
                          <a href="/receipt/create?visit_id=<%= r.visit.visit_id %>">#<%= r.visit.visit_id %></a>
                          <small class="d-block text-muted"><%= r.visit.visit_date %></small>
                        </td>
                        <td><span class="fw-semibold"><i class="fa-solid fa-paw text-primary me-1"></i><%= r.visit.pet_name %></span></td>
                        <td>
                          <% if (r.items.length) { %>
                            <% r.items.forEach(item => { %>
                              <div class="text-nowrap"><%= item.stock_name %> × <%= item.quantity %></div>
                            <% }) %>
                          <% } else { %>
                            <span class="text-muted">ไม่มีรายการสินค้า</span>
                          <% } %>
                        </td>
                        <td class="text-nowrap fw-semibold money">฿<%= Number(r.transaction.total_price || 0).toLocaleString('th-TH', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                        <td>
                          <% if (r.payment_status === 'paid') { %>
                            <span class="badge text-bg-success">Paid</span>
                          <% } else if (r.payment_status === 'cancelled') { %>
                            <span class="badge text-bg-danger">Cancelled</span>
                          <% } else { %>
                            <span class="badge text-bg-warning">Pending</span>
                          <% } %>
                        </td>
                        <td class="text-nowrap"><%= r.created_at ? new Date(r.created_at).toLocaleDateString('th-TH') : '-' %></td>
                        <td class="text-nowrap">
                          <a href="/receipt/create?visit_id=<%= r.visit.visit_id %>" class="btn btn-sm btn-outline-primary mb-1" title="ดูรายละเอียด">
                            <i class="fa-solid fa-eye me-1"></i>รายละเอียด
                          </a>
                          <% if (r.payment_status !== 'cancelled') { %>
                            <button type="button"
                              class="btn btn-sm <%= r.payment_status === 'paid' ? 'btn-outline-warning' : 'btn-outline-success' %> payment-button mb-1"
                              data-receipt-id="<%= r.receipt_id %>"
                              data-current="<%= r.payment_status %>"
                              data-bs-toggle="modal" data-bs-target="#paymentModal">
                              <i class="fa-solid <%= r.payment_status === 'paid' ? 'fa-rotate-left' : 'fa-check' %> me-1"></i>
                              <%= r.payment_status === 'paid' ? 'เปลี่ยนเป็น Pending' : 'ยืนยันชำระเงิน' %>
                            </button>
                          <% } %>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
              <p id="noReceiptResult" class="text-center text-muted py-4 d-none">ไม่พบผลการค้นหา</p>
            <% } %>
          </div>
        </section>
      </main>
    </div>
  </div>

  <div class="modal fade" id="paymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <form method="POST" id="paymentForm">
          <div class="modal-header">
            <h5 class="modal-title"><i class="fa-solid fa-money-bill-wave text-primary me-2"></i>ยืนยันสถานะชำระเงิน</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <p id="paymentConfirmText" class="mb-2"></p>
            <div class="alert alert-warning mb-0">
              <i class="fa-solid fa-circle-info me-1"></i>เป็นการจำลองสถานะ ไม่มีการรับชำระเงินจริง
            </div>
            <input type="hidden" name="payment_status" id="nextPaymentStatus">
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-light" data-bs-dismiss="modal">ยกเลิก</button>
            <button type="submit" class="btn btn-primary">ยืนยัน</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const searchInput = document.getElementById('receiptSearch');
    const receiptRows = [...document.querySelectorAll('#receiptTableBody tr')];
    const statusButtons = [...document.querySelectorAll('.status-toggle')];
    let activeStatus = 'all';

    function filterReceipts() {
      const query = (searchInput?.value || '').trim().toLowerCase();
      let shown = 0;

      receiptRows.forEach(row => {
        const matchesStatus = activeStatus === 'all' || row.dataset.status === activeStatus;
        const matchesSearch = (row.dataset.search || '').includes(query);
        const visible = matchesStatus && matchesSearch;
        row.classList.toggle('d-none', !visible);
        if (visible) shown++;
      });

      document.getElementById('noReceiptResult')?.classList.toggle('d-none', shown > 0);
    }

    statusButtons.forEach(button => {
      button.addEventListener('click', () => {
        activeStatus = button.dataset.status;
        statusButtons.forEach(item => {
          const selected = item === button;
          item.classList.toggle('btn-primary', selected);
          item.classList.toggle('btn-outline-primary', !selected);
          const badge = item.querySelector('.badge');
          badge?.classList.toggle('text-bg-light', selected);
          badge?.classList.toggle('text-bg-secondary', !selected);
        });
        filterReceipts();
      });
    });

    searchInput?.addEventListener('input', filterReceipts);

    document.querySelectorAll('.payment-button').forEach(button => {
      button.addEventListener('click', () => {
        const receiptId = button.dataset.receiptId;
        const next = button.dataset.current === 'paid' ? 'pending' : 'paid';
        document.getElementById('paymentForm').action = `/receipt/payment/${receiptId}`;
        document.getElementById('nextPaymentStatus').value = next;
        document.getElementById('paymentConfirmText').textContent = next === 'paid'
          ? `ยืนยันเปลี่ยน Receipt #${receiptId} เป็น Paid หรือไม่?`
          : `ยืนยันเปลี่ยน Receipt #${receiptId} กลับเป็น Pending หรือไม่?`;
      });
    });
  </script>
</body>
</html>
