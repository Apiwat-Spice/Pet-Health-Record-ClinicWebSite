
<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Receipt - WebClinic</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <style>
    body { background: #f8f9fa; }
    main { min-width: 0; }
    .content-card { border: 0; border-radius: 12px; box-shadow: 0 .125rem .5rem rgba(0,0,0,.06); }
    .page-title { color: #24364b; font-weight: 700; }
    .btn-primary { background: #315f85; border-color: #315f85; }
    .btn-primary:hover { background: #244967; border-color: #244967; }
    .section-title { font-size: 1rem; font-weight: 700; color: #24364b; }
    .info-box { background: #f1f5f9; border-radius: 10px; height: 100%; }
    .info-label { font-size: .8rem; color: #6c757d; margin-bottom: .25rem; }
    .money { font-variant-numeric: tabular-nums; }
    .table th { white-space: nowrap; }
    .table td { vertical-align: middle; }
    @media (max-width: 576px) {
      main { padding: 1rem !important; }
    }
  </style>
</head>
<body>
  <%- include('../partial/navbar') %>
  <div class="container-fluid">
    <div class="row">
      <%- include('../partial/menu') %>
      <main class="col-md-9 col-lg-10 p-4">
        <div class="mb-4">
          <h2 class="page-title mb-1"><i class="fa-solid fa-receipt text-primary me-2"></i>Receipt</h2>
          <p class="text-muted mb-0">สร้างใบเสร็จและบันทึกรายการสินค้าที่ใช้ในการรักษา</p>
        </div>

        <% if (locals.success) { %>
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i><%= success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>
        <% if (locals.error) { %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i><%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>

        <section class="card content-card mb-4" id="visitRecordsSection">
          <div class="card-body p-3 p-md-4">
            <h5 class="section-title mb-3"><i class="fa-solid fa-clipboard-list text-primary me-2"></i>ข้อมูล Visit Record</h5>

            <% if (!visits.length) { %>
              <div class="text-center text-muted py-5">
                <i class="fa-regular fa-folder-open fa-3x mb-3"></i>
                <h6>ไม่พบ Visit Record</h6>
                <p class="mb-0">ตรวจสอบ Visit Record และสถานะ Appointment ก่อนสร้าง Receipt</p>
              </div>
            <% } else { %>
              <div class="row g-3 mb-3 align-items-end">
                <div class="col-md-4">
                  <label for="visitSort" class="form-label fw-semibold">เรียงตามวันที่</label>
                  <select id="visitSort" class="form-select">
                    <option value="newest">ใหม่สุดก่อน</option>
                    <option value="oldest">เก่าสุดก่อน</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label for="visitDocumentFilter" class="form-label fw-semibold">สถานะเอกสาร</label>
                  <select id="visitDocumentFilter" class="form-select">
                    <option value="all">ทั้งหมด</option>
                    <option value="pending">ยังไม่มีเอกสาร</option>
                    <option value="done">ทำเอกสารแล้ว</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label for="visitSearch" class="form-label fw-semibold">ค้นหา</label>
                  <input type="search" id="visitSearch" class="form-control" placeholder="ค้นหา Visit ID หรือชื่อสัตว์เลี้ยง">
                </div>
              </div>
              <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                <div class="small text-muted">เลือก Visit Record ที่ต้องการ แล้วกด “จัดการ” เพื่อดูรายละเอียดและทำรายการสินค้า</div>
                <div class="small text-muted">แสดง <strong id="visitResultCount"><%= visits.length %></strong> รายการ</div>
              </div>
              <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0" id="visitTable">
                  <thead class="table-light">
                    <tr>
                      <th>Visit Record</th>
                      <th>สัตว์เลี้ยง</th>
                      <th>วันที่เข้ารับบริการ</th>
                      <th>Appointment</th>
                      <th>สถานะเอกสาร</th>
                      <th class="text-center">จัดการ</th>
                    </tr>
                  </thead>
                  <tbody id="visitTableBody">
                    <% visits.forEach(v => { %>
                      <tr data-visit-id="<%= v.visit_id %>" data-visit-date="<%= v.visit_date || '' %>" data-pet-name="<%= v.pet_name || '' %>" data-has-document="<%= v.transaction ? 'true' : 'false' %>" class="<%= String(v.visit_id) === String(selectedVisitId) ? 'table-primary' : '' %>">
                        <td class="fw-semibold">#<%= v.visit_id %></td>
                        <td><i class="fa-solid fa-paw text-primary me-1"></i><%= v.pet_name || '-' %></td>
                        <td><%= v.visit_date || '-' %></td>
                        <td>#<%= v.appointment_id || '-' %></td>
                        <td>
                          <% if (v.transaction) { %>
                            <span class="badge text-bg-success"><i class="fa-solid fa-check me-1"></i>ทำเอกสารแล้ว</span>
                          <% } else { %>
                            <span class="badge text-bg-warning">ยังไม่มีเอกสาร</span>
                          <% } %>
                        </td>
                        <td class="text-center">
                          <a href="/receipt/create?visit_id=<%= encodeURIComponent(v.visit_id) %>" class="btn btn-sm <%= String(v.visit_id) === String(selectedVisitId) ? 'btn-primary' : 'btn-outline-primary' %>">
                            <i class="fa-solid fa-gear me-1"></i>จัดการ
                          </a>
                        </td>
                      </tr>
                    <% }) %>
                    <tr id="noVisitMatch" class="d-none">
                      <td colspan="6" class="text-center text-muted py-4">ไม่พบ Visit Record ที่ตรงกับตัวกรอง</td>
                    </tr>
                  </tbody>
                </table>
              </div>

            <% } %>
          </div>
        </section>
      </main>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const visitTableBody = document.getElementById('visitTableBody');
    const visitSort = document.getElementById('visitSort');
    const visitDocumentFilter = document.getElementById('visitDocumentFilter');
    const visitSearch = document.getElementById('visitSearch');
    const visitResultCount = document.getElementById('visitResultCount');
    const noVisitMatch = document.getElementById('noVisitMatch');

    function filterAndSortVisits() {
      if (!visitTableBody) return;
      const rows = [...visitTableBody.querySelectorAll('tr[data-visit-id]')];
      const documentFilter = visitDocumentFilter?.value || 'all';
      const searchTerm = (visitSearch?.value || '').trim().toLowerCase();
      const sortOrder = visitSort?.value || 'newest';

      rows.forEach(row => {
        const hasDocument = row.dataset.hasDocument === 'true';
        const visitId = (row.dataset.visitId || '').toLowerCase();
        const petName = (row.dataset.petName || '').toLowerCase();
        const matchesDocument = documentFilter === 'all' ||
          (documentFilter === 'done' && hasDocument) ||
          (documentFilter === 'pending' && !hasDocument);
        const matchesSearch = !searchTerm || visitId.includes(searchTerm) || petName.includes(searchTerm);
        row.classList.toggle('d-none', !(matchesDocument && matchesSearch));
      });

      const sortedRows = rows.sort((a, b) => {
        const dateA = Date.parse(a.dataset.visitDate || '') || 0;
        const dateB = Date.parse(b.dataset.visitDate || '') || 0;
        const dateDifference = sortOrder === 'oldest' ? dateA - dateB : dateB - dateA;
        return dateDifference || (sortOrder === 'oldest'
          ? Number(a.dataset.visitId) - Number(b.dataset.visitId)
          : Number(b.dataset.visitId) - Number(a.dataset.visitId));
      });

      sortedRows.forEach(row => visitTableBody.insertBefore(row, noVisitMatch));
      const visibleCount = rows.filter(row => !row.classList.contains('d-none')).length;
      if (visitResultCount) visitResultCount.textContent = visibleCount;
      if (noVisitMatch) noVisitMatch.classList.toggle('d-none', visibleCount > 0);
    }

    visitSort?.addEventListener('change', filterAndSortVisits);
    visitDocumentFilter?.addEventListener('change', filterAndSortVisits);
    visitSearch?.addEventListener('input', filterAndSortVisits);
    filterAndSortVisits();

    if (new URLSearchParams(window.location.search).has('visit_id')) {
      document.getElementById('receiptForm')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

  </script>
</body>
</html>