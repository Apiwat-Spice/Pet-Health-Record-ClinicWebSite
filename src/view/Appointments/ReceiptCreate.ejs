
<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create Receipt - WebClinic</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <style>
    body { background: #f8f9fa; }
    main { min-width: 0; }
    .content-card { border: 0; border-radius: 12px; box-shadow: 0 .125rem .5rem rgba(0,0,0,.06); }
    .page-title { color: #24364b; font-weight: 700; }
    .btn-primary { background: #315f85; border-color: #315f85; }
    .btn-primary:hover { background: #244967; border-color: #244967; }
    .section-title { font-size: 1rem; font-weight: 700; color: #24364b; }
    .info-box { background: #f1f5f9; border-radius: 10px; height: 100%; }
    .info-label { font-size: .8rem; color: #6c757d; margin-bottom: .25rem; }
    .money { font-variant-numeric: tabular-nums; }
    .table th { white-space: nowrap; }
    .table td { vertical-align: middle; }
    @media (max-width: 576px) {
      main { padding: 1rem !important; }
    }
  </style>
</head>
<body>
  <%- include('../partial/navbar') %>
  <div class="container-fluid">
    <div class="row">
      <%- include('../partial/menu') %>
      <main class="col-md-9 col-lg-10 p-4">
        <div class="mb-4">
          <h2 class="page-title mb-1"><i class="fa-solid fa-file-circle-plus text-primary me-2"></i>Create Receipt</h2>
          <p class="text-muted mb-0">สร้างใบเสร็จและบันทึกรายการสินค้าที่ใช้ในการรักษา</p>
        </div>

        <% if (locals.success) { %>
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i><%= success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>
        <% if (locals.error) { %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i><%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>

        <section class="card content-card mb-4">
          <div class="card-body p-3">
            <div class="btn-group flex-wrap" role="group" aria-label="Receipt navigation">
              <a href="/receipt" class="btn btn-outline-primary">
                <i class="fa-solid fa-list-check me-1"></i>Receipt ทั้งหมด
              </a>
              <a href="/receipt/create" class="btn btn-primary">
                <i class="fa-solid fa-plus me-1"></i>สร้าง Receipt
              </a>
            </div>
          </div>
        </section>

        <section class="card content-card mb-4">
          <div class="card-body p-3 p-md-4">
            <h5 class="section-title mb-3"><i class="fa-solid fa-clipboard-list text-primary me-2"></i>ข้อมูล Visit Record</h5>

            <% if (!visits.length) { %>
              <div class="text-center text-muted py-5">
                <i class="fa-regular fa-folder-open fa-3x mb-3"></i>
                <h6>ไม่พบ Visit Record</h6>
                <p class="mb-0">ตรวจสอบ Visit Record และสถานะ Appointment ก่อนสร้าง Receipt</p>
              </div>
            <% } else { %>
              <label for="visitSelector" class="form-label fw-semibold">เลือก Visit Record <span class="text-danger">*</span></label>
              <select id="visitSelector" class="form-select mb-2">
                <% visits.forEach(v => { %>
                  <option value="<%= v.visit_id %>" <%= String(v.visit_id) === String(selectedVisitId) ? 'selected' : '' %>>
                    Visit #<%= v.visit_id %> — <%= v.pet_name %> — <%= v.visit_date %><%= v.transaction ? ' (มี Transaction แล้ว)' : '' %>
                  </option>
                <% }) %>
              </select>
              <div class="form-text mb-4">เลือก Visit Record ที่ต้องการสร้างหรือแก้ไขรายการสินค้า</div>

              <% if (selectedVisit) { %>
                <% const appt = selectedVisit.appointment || {}; %>
                <div class="row g-3">
                  <div class="col-sm-6 col-xl-3">
                    <div class="info-box p-3">
                      <div class="info-label">Visit Record</div>
                      <div class="fw-semibold">#<%= selectedVisit.visit_id %></div>
                    </div>
                  </div>
                  <div class="col-sm-6 col-xl-3">
                    <div class="info-box p-3">
                      <div class="info-label">สัตว์เลี้ยง</div>
                      <div class="fw-semibold"><i class="fa-solid fa-paw text-primary me-1"></i><%= selectedVisit.pet_name %></div>
                    </div>
                  </div>
                  <div class="col-sm-6 col-xl-3">
                    <div class="info-box p-3">
                      <div class="info-label">วันที่เข้ารับบริการ</div>
                      <div class="fw-semibold"><%= selectedVisit.visit_date %></div>
                    </div>
                  </div>
                  <div class="col-sm-6 col-xl-3">
                    <div class="info-box p-3">
                      <div class="info-label">Appointment</div>
                      <div class="fw-semibold">#<%= selectedVisit.appointment_id %></div>
                      <small class="text-muted"><%= appt.title || '-' %></small>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="info-box p-3">
                      <div class="info-label">อาการ (Symptoms)</div>
                      <div class="text-break"><%= selectedVisit.symptoms || '-' %></div>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="info-box p-3">
                      <div class="info-label">น้ำหนัก (Weight)</div>
                      <div class="text-break"><%= selectedVisit.weight == null ? '-' : selectedVisit.weight + ' kg' %></div>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="info-box p-3">
                      <div class="info-label">การวินิจฉัย (Diagnosis)</div>
                      <div class="text-break"><%= selectedVisit.diagnosis || '-' %></div>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="info-box p-3">
                      <div class="info-label">การรักษา (Treatment)</div>
                      <div class="text-break"><%= selectedVisit.treatment || '-' %></div>
                    </div>
                  </div>
                  <div class="col-12">
                    <div class="info-box p-3">
                      <div class="info-label">หมายเหตุ (Note)</div>
                      <div class="text-break"><%= selectedVisit.note || '-' %></div>
                    </div>
                  </div>
                </div>
              <% } %>
            <% } %>
          </div>
        </section>

        <% if (selectedVisit) { %>
          <form action="/receipt/save" method="POST" id="receiptForm">
            <input type="hidden" name="visit_id" value="<%= selectedVisit.visit_id %>">
            <input type="hidden" name="items_json" id="itemsJson">

            <section class="card content-card mb-4">
              <div class="card-body p-3 p-md-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                  <h5 class="section-title mb-0"><i class="fa-solid fa-boxes-stacked text-primary me-2"></i>รายการสินค้าและค่าบริการ</h5>
                  <button type="button" id="addItemBtn" class="btn btn-outline-primary">
                    <i class="fa-solid fa-plus me-1"></i>เพิ่มสินค้า
                  </button>
                </div>
                <div class="alert alert-info py-2">
                  <i class="fa-solid fa-circle-info me-1"></i>ราคาต่อหน่วยเริ่มต้นจากราคาสินค้าในคลัง สามารถปรับราคาในใบเสร็จได้
                </div>
                <div class="table-responsive">
                  <table class="table table-bordered align-middle">
                    <thead class="table-light">
                      <tr>
                        <th style="min-width:260px">สินค้า</th>
                        <th style="min-width:120px">คงเหลือ</th>
                        <th style="min-width:110px">จำนวน</th>
                        <th style="min-width:150px">ราคาต่อหน่วย (฿)</th>
                        <th style="min-width:150px">รวม (฿)</th>
                        <th style="width:70px">ลบ</th>
                      </tr>
                    </thead>
                    <tbody id="itemsTableBody"></tbody>
                  </table>
                </div>
                <div id="emptyItems" class="text-center text-muted py-4 d-none">
                  <i class="fa-solid fa-cart-plus fa-2x mb-2"></i>
                  <p class="mb-0">ยังไม่มีสินค้า กด “เพิ่มสินค้า” เพื่อเริ่มต้น</p>
                </div>
              </div>

              <div class="card-body p-3 p-md-4">
                <div class="row g-3 align-items-center">
                  <div class="col-md-6 text-muted">
                    <div>จำนวนรายการสินค้า: <strong id="itemCount">0</strong> รายการ</div>
                    <small>ยอดรวมคำนวณจากจำนวน × ราคาต่อหน่วย</small>
                  </div>
                  <div class="col-md-6">
                    <div class="info-box p-3">
                      <div class="d-flex justify-content-between align-items-center gap-3">
                        <span class="fw-semibold">ยอดรวมสุทธิ</span>
                        <h3 class="mb-0 text-primary money">฿<span id="grandTotal">0.00</span></h3>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </section>

            <div class="d-flex flex-wrap justify-content-end gap-2 mb-4">
              <a href="/receipt" class="btn btn-outline-secondary"><i class="fa-solid fa-arrow-left me-1"></i>กลับรายการ Receipt</a>
              <button type="submit" class="btn btn-primary" id="saveReceiptBtn">
                <i class="fa-solid fa-floppy-disk me-1"></i><%= selectedTransaction ? 'บันทึกการแก้ไข' : 'สร้าง Receipt' %>
              </button>
            </div>
          </form>
        <% } %>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const stockData = <%- JSON.stringify(stocks).replace(/</g, '\\u003c') %>;
    const initialItems = <%- JSON.stringify(selectedItems).replace(/</g, '\\u003c') %>;
    const tableBody = document.getElementById('itemsTableBody');
    const emptyItems = document.getElementById('emptyItems');
    const totalElement = document.getElementById('grandTotal');
    const itemsJson = document.getElementById('itemsJson');
    const receiptForm = document.getElementById('receiptForm');

    document.getElementById('visitSelector')?.addEventListener('change', function () {
      window.location.href = '/receipt/create?visit_id=' + encodeURIComponent(this.value);
    });

    function money(value) {
      return Number(value || 0).toLocaleString('th-TH', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });
    }

    function getStock(stockId) {
      return stockData.find(stock => String(stock.stock_id) === String(stockId));
    }

    function createCell(className) {
      const cell = document.createElement('td');
      if (className) cell.className = className;
      return cell;
    }

    function updateStockOptions() {
      const rows = [...tableBody.querySelectorAll('tr')];
      const selectedIds = rows.map(row => row.querySelector('.item-stock').value).filter(Boolean);

      rows.forEach(row => {
        const select = row.querySelector('.item-stock');
        [...select.options].forEach(option => {
          if (option.value) {
            option.disabled = selectedIds.includes(option.value) && option.value !== select.value;
          }
        });
      });
    }

    function updateTotals() {
      let total = 0;
      const rows = [...tableBody.querySelectorAll('tr')];

      rows.forEach(row => {
        const quantity = Number(row.querySelector('.item-quantity').value);
        const price = Number(row.querySelector('.item-price').value);
        const subtotal = quantity > 0 && price >= 0 ? quantity * price : 0;
        row.querySelector('.item-subtotal').textContent = money(subtotal);
        total += subtotal;
      });

      totalElement.textContent = money(total);
      document.getElementById('itemCount').textContent = rows.length;
      emptyItems.classList.toggle('d-none', rows.length > 0);
    }

    function addItem(item = {}) {
      const row = document.createElement('tr');
      const stockCell = createCell();
      const stockSelect = document.createElement('select');
      stockSelect.className = 'form-select item-stock';
      stockSelect.required = true;

      const placeholder = document.createElement('option');
      placeholder.value = '';
      placeholder.textContent = '-- เลือกสินค้า --';
      stockSelect.appendChild(placeholder);

      stockData.forEach(stock => {
        const option = document.createElement('option');
        option.value = stock.stock_id;
        option.textContent = `${stock.name} — ${stock.quantity} ${stock.type_unit || ''}${stock.expires_status === 'expired' ? ' (หมดอายุ)' : ''}`;
        if (String(stock.stock_id) === String(item.stock_id)) option.selected = true;
        stockSelect.appendChild(option);
      });

      stockCell.appendChild(stockSelect);
      row.appendChild(stockCell);

      const stockCellQuantity = createCell();
      const stockQuantity = document.createElement('span');
      stockQuantity.className = 'small text-muted stock-quantity';
      stockCellQuantity.appendChild(stockQuantity);
      row.appendChild(stockCellQuantity);

      const qtyCell = createCell();
      const qtyInput = document.createElement('input');
      qtyInput.type = 'number';
      qtyInput.min = '1';
      qtyInput.step = '1';
      qtyInput.required = true;
      qtyInput.value = item.quantity ?? 1;
      qtyInput.className = 'form-control item-quantity';
      qtyCell.appendChild(qtyInput);
      row.appendChild(qtyCell);

      const priceCell = createCell();
      const priceInput = document.createElement('input');
      priceInput.type = 'number';
      priceInput.min = '0';
      priceInput.step = '0.01';
      priceInput.required = true;
      priceInput.value = item.unit_price ?? '';
      priceInput.className = 'form-control item-price';
      priceCell.appendChild(priceInput);
      row.appendChild(priceCell);

      const subtotalCell = createCell('text-end text-nowrap money');
      subtotalCell.innerHTML = '฿<span class="item-subtotal">0.00</span>';
      row.appendChild(subtotalCell);

      const removeCell = createCell('text-center');
      const removeButton = document.createElement('button');
      removeButton.type = 'button';
      removeButton.className = 'btn btn-sm btn-outline-danger';
      removeButton.innerHTML = '<i class="fa-solid fa-trash"></i>';
      removeButton.setAttribute('aria-label', 'ลบรายการสินค้า');
      removeButton.addEventListener('click', () => {
        row.remove();
        updateStockOptions();
        updateTotals();
      });
      removeCell.appendChild(removeButton);
      row.appendChild(removeCell);

function refreshStock(resetPrice = false) {
  const stock = getStock(stockSelect.value);
  stockQuantity.textContent = stock
    ? `${stock.quantity} ${stock.type_unit || ''}`
    : '-';

  if (stock && (resetPrice || item.unit_price == null)) {
    priceInput.value = Number(stock.price || 0).toFixed(2);
    item.unit_price = Number(priceInput.value);
    delete priceInput.dataset.edited;
  }

  updateStockOptions();
  updateTotals();
}

stockSelect.addEventListener('change', () => {
  item.unit_price = null;
  delete priceInput.dataset.edited;
  refreshStock(true);
});

      priceInput.addEventListener('input', () => {
        priceInput.dataset.edited = '1';
        updateTotals();
      });

      qtyInput.addEventListener('input', updateTotals);
      tableBody.appendChild(row);
      refreshStock();
    }

    document.getElementById('addItemBtn')?.addEventListener('click', () => addItem());

    if (tableBody && receiptForm) {
      initialItems.forEach(item => addItem(item));
      updateTotals();

      receiptForm.addEventListener('submit', event => {
        const rows = [...tableBody.querySelectorAll('tr')];

        if (!rows.length) {
          event.preventDefault();
          alert('กรุณาเพิ่มสินค้าอย่างน้อย 1 รายการ');
          return;
        }

        const items = [];

        for (const row of rows) {
          const stockId = Number(row.querySelector('.item-stock').value);
          const quantity = Number(row.querySelector('.item-quantity').value);
          const unitPrice = Number(row.querySelector('.item-price').value);
          const stock = getStock(stockId);

          if (!stock || !Number.isSafeInteger(quantity) || quantity <= 0 ||
              !Number.isFinite(unitPrice) || unitPrice < 0 ||
              Math.round(unitPrice * 100) !== unitPrice * 100) {
            event.preventDefault();
            alert('กรุณาตรวจสอบสินค้า จำนวน และราคาต่อหน่วยให้ถูกต้อง');
            return;
          }

          if (quantity > Number(stock.quantity)) {
            event.preventDefault();
            alert(`สินค้า ${stock.name} มีจำนวนคงเหลือไม่เพียงพอ`);
            return;
          }

          items.push({
            stock_id: stockId,
            quantity,
            unit_price: Math.round(unitPrice * 100) / 100
          });
        }

        if (new Set(items.map(item => item.stock_id)).size !== items.length) {
          event.preventDefault();
          alert('ไม่สามารถเลือกสินค้าชนิดเดียวกันซ้ำหลายแถวได้');
          return;
        }

        itemsJson.value = JSON.stringify(items);
        const saveButton = document.getElementById('saveReceiptBtn');
        saveButton.disabled = true;
        saveButton.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>กำลังบันทึก...';
      });
    }
  </script>
</body>
</html>
