<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Room Detail - WebClinic</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <style>
    @media (max-width: 576px) {
      main { padding: 1rem !important; }
    }
    .detail-label { color: #6c757d; font-size: .9rem; margin-bottom: .35rem; }
    .detail-value { font-weight: 500; overflow-wrap: anywhere; }
    .room-icon { width: 64px; height: 64px; display: grid; place-items: center; border-radius: 16px; background: #e7f1ff; color: #0d6efd; font-size: 1.8rem; }
  </style>
</head>
<body class="bg-light">
  <%- include('../partial/navbar') %>
  <div class="container-fluid">
    <div class="row">
      <%- include('../partial/menu') %>
      <main class="col-md-9 col-lg-10 p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
          <div>
            <h2 class="fw-bold"><i class="fa-solid fa-hospital text-primary me-2"></i>Room Detail</h2>
            <p class="text-muted mb-0">รายละเอียดข้อมูลห้องพักสัตว์ป่วยใน</p>
          </div>
          <a href="/ipd/rooms" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i> กลับรายการห้อง
          </a>
        </div>
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-body p-4">
            <div class="d-flex flex-wrap align-items-center gap-3">
              <div class="room-icon"><i class="fa-solid fa-hospital"></i></div>
              <div class="flex-grow-1">
                <div class="text-muted small">รหัสห้อง</div>
                <h3 class="fw-bold mb-1"><%= room.room_code %></h3>
                <div class="d-flex flex-wrap gap-2">
                  <% if (room.status === 'full') { %>
                    <span class="badge text-bg-danger">เต็ม</span>
                  <% } else { %>
                    <span class="badge text-bg-success">ยังไม่เต็ม</span>
                  <% } %>
                  <% const typeLabels = { general: 'General', icu: 'ICU', isolation: 'Isolation', cat_ward: 'Cat Ward', dog_ward: 'Dog Ward' }; %>
                  <span class="badge text-bg-info"><%= typeLabels[room.type] || room.type %></span>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="card border-0 shadow-sm">
          <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold"><i class="fa-solid fa-circle-info text-primary me-2"></i>ข้อมูลห้อง</h5>
          </div>
          <div class="card-body p-4">
            <div class="row g-4">
              <div class="col-md-6">
                <div class="detail-label">Room ID</div>
                <div class="detail-value"><%= room.room_id %></div>
              </div>
              <div class="col-md-6">
                <div class="detail-label">รหัสห้อง</div>
                <div class="detail-value"><%= room.room_code %></div>
              </div>
              <div class="col-md-6">
                <div class="detail-label">ประเภทห้อง</div>
                <div class="detail-value"><%= typeLabels[room.type] || room.type %></div>
              </div>
              <div class="col-md-6">
                <div class="detail-label">จำนวนสัตว์ที่รองรับ</div>
                <div class="detail-value"><i class="fa-solid fa-paw text-secondary me-1"></i><%= room.pet_amount %> ตัว</div>
              </div>
              <div class="col-md-6">
                <div class="detail-label">สถานะห้อง</div>
                <div class="detail-value"><%= room.status === 'full' ? 'เต็ม' : 'ยังไม่เต็ม' %></div>
              </div>
              <div class="col-md-6">
                <div class="detail-label">วันที่สร้าง</div>
                <div class="detail-value"><%= room.created_at ? new Date(room.created_at).toLocaleString('th-TH', { dateStyle: 'medium', timeStyle: 'short' }) : '-' %></div>
              </div>
              <div class="col-md-6">
                <div class="detail-label">แก้ไขล่าสุด</div>
                <div class="detail-value"><%= room.updated_at ? new Date(room.updated_at).toLocaleString('th-TH', { dateStyle: 'medium', timeStyle: 'short' }) : '-' %></div>
              </div>
              <div class="col-12">
                <div class="detail-label">รายละเอียดเพิ่มเติม</div>
                <div class="detail-value"><%= room.detail || 'ไม่มีรายละเอียดเพิ่มเติม' %></div>
              </div>
            </div>
          </div>
        </div>
        <div class="text-end mt-4">
          <a href="/ipd/rooms" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i> กลับรายการห้อง
          </a>
        </div>
      </main>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>