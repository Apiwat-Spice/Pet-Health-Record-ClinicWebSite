<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>IPD Rooms - WebClinic</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <style>
    @media (max-width: 576px) {
      main { padding: 1rem !important; }
    }
    .table td, .table th { vertical-align: middle; }
  </style>
</head>
<body class="bg-light">
  <%- include('../partial/navbar') %>
  <div class="container-fluid">
    <div class="row">
      <%- include('../partial/menu') %>
      <main class="col-md-9 col-lg-10 p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
          <div>
            <h2 class="fw-bold"><i class="fa-solid fa-hospital text-primary me-2"></i>IPD Rooms</h2>
            <p class="text-muted mb-0">จัดการข้อมูลห้องพักสัตว์ป่วยใน</p>
          </div>
          <a href="/ipd/rooms/create" class="btn btn-success text-nowrap">
            <i class="fa-solid fa-plus me-1"></i> เพิ่มห้อง
          </a>
        </div>
        <div class="card border-0 shadow-sm">
          <div class="card-body">
            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <input id="roomSearch" type="search" class="form-control" placeholder="ค้นหารหัสห้องหรือรายละเอียด">
              </div>
              <div class="col-md-3">
                <select id="typeFilter" class="form-select">
                  <option value="">ทุกประเภทห้อง</option>
                  <option value="general">General</option>
                  <option value="icu">ICU</option>
                  <option value="isolation">Isolation</option>
                  <option value="cat_ward">Cat Ward</option>
                  <option value="dog_ward">Dog Ward</option>
                </select>
              </div>
              <div class="col-md-3">
                <select id="statusFilter" class="form-select">
                  <option value="">ทุกสถานะ</option>
                  <option value="not_full">ยังไม่เต็ม</option>
                  <option value="full">เต็ม</option>
                </select>
              </div>
            </div>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead class="table-light">
                  <tr>
                    <th>รหัสห้อง</th>
                    <th>ประเภทห้อง</th>
                    <th>รองรับสัตว์</th>
                    <th>สถานะ</th>
                    <th>รายละเอียด</th>
                    <th>จัดการ</th>
                  </tr>
                </thead>
                <tbody id="roomTable">
                  <% if (!rooms || rooms.length === 0) { %>
                    <tr>
                      <td colspan="6" class="text-center text-muted py-5">
                        <i class="fa-solid fa-hospital fa-2x mb-2 d-block"></i>
                        ยังไม่มีข้อมูลห้อง
                      </td>
                    </tr>
                  <% } else { %>
                    <% rooms.forEach(room => { %>
                      <tr data-search="<%= `${room.room_code} ${room.detail || ''}`.toLowerCase() %>" data-type="<%= room.type %>" data-status="<%= room.status %>">
                        <td class="fw-semibold"><%= room.room_code %></td>
                        <td>
                          <% const typeLabels = { general: 'General', icu: 'ICU', isolation: 'Isolation', cat_ward: 'Cat Ward', dog_ward: 'Dog Ward' }; %>
                          <span class="badge text-bg-info"><%= typeLabels[room.type] || room.type %></span>
                        </td>
                        <td><i class="fa-solid fa-paw me-1 text-secondary"></i><%= room.pet_amount %> ตัว</td>
                        <td>
                          <% if (room.status === 'full') { %>
                            <span class="badge text-bg-danger">เต็ม</span>
                          <% } else { %>
                            <span class="badge text-bg-success">ยังไม่เต็ม</span>
                          <% } %>
                        </td>
                        <td><%= room.detail || '-' %></td>
                        <td>
                          <a href="/ipd/rooms/<%= room.room_id %>" class="btn btn-sm btn-outline-primary text-nowrap">
                            <i class="fa-solid fa-eye me-1"></i> ดูรายละเอียด
                          </a>
                        </td>
                      </tr>
                    <% }) %>
                  <% } %>
                  <tr id="noResults" class="d-none">
                    <td colspan="6" class="text-center text-muted py-4">ไม่พบห้องที่ตรงกับการค้นหา</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const searchInput = document.getElementById('roomSearch');
    const typeFilter = document.getElementById('typeFilter');
    const statusFilter = document.getElementById('statusFilter');
    const roomRows = [...document.querySelectorAll('#roomTable tr[data-search]')];
    const noResults = document.getElementById('noResults');
    function filterRooms() {
      const query = searchInput.value.trim().toLowerCase();
      let visible = 0;
      roomRows.forEach(row => {
        const match = row.dataset.search.includes(query)
          && (!typeFilter.value || row.dataset.type === typeFilter.value)
          && (!statusFilter.value || row.dataset.status === statusFilter.value);
        row.classList.toggle('d-none', !match);
        if (match) visible++;
      });
      noResults.classList.toggle('d-none', visible > 0 || roomRows.length === 0);
    }
    searchInput.addEventListener('input', filterRooms);
    typeFilter.addEventListener('change', filterRooms);
    statusFilter.addEventListener('change', filterRooms);
  </script>
</body>
</html>