<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add IPD Room - WebClinic</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <style>
    @media (max-width: 576px) {
      main { padding: 1rem !important; }
    }
  </style>
</head>
<body class="bg-light">
  <%- include('../partial/navbar') %>
  <div class="container-fluid">
    <div class="row">
      <%- include('../partial/menu') %>
      <main class="col-md-9 col-lg-10 p-4">
        <div class="mb-4">
          <h2 class="fw-bold"><i class="fa-solid fa-hospital text-primary me-2"></i>เพิ่มห้อง IPD</h2>
          <p class="text-muted mb-0">กรอกข้อมูลห้องพักสัตว์ป่วยใน</p>
        </div>
        <% if (locals.error) { %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i><%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>
        <div class="card border-0 shadow-sm">
          <div class="card-body p-4">
            <form method="POST" action="/ipd/rooms/create">
              <div class="row g-3">
                <div class="col-md-6">
                  <label for="roomCode" class="form-label">รหัสห้อง <span class="text-danger">*</span></label>
                  <input id="roomCode" name="room_code" type="text" class="form-control" maxlength="50" value="<%= room.room_code || '' %>" placeholder="เช่น IPD-101" required>
                  <div class="form-text">รหัสห้องต้องไม่ซ้ำกับห้องอื่น</div>
                </div>
                <div class="col-md-6">
                  <label for="roomType" class="form-label">ประเภทห้อง <span class="text-danger">*</span></label>
                  <select id="roomType" name="type" class="form-select" required>
                    <option value="general" <%= room.type === 'general' || !room.type ? 'selected' : '' %>>General - ห้องทั่วไป</option>
                    <option value="icu" <%= room.type === 'icu' ? 'selected' : '' %>>ICU - ห้องผู้ป่วยวิกฤต</option>
                    <option value="isolation" <%= room.type === 'isolation' ? 'selected' : '' %>>Isolation - ห้องแยกโรค</option>
                    <option value="cat_ward" <%= room.type === 'cat_ward' ? 'selected' : '' %>>Cat Ward - ห้องแมว</option>
                    <option value="dog_ward" <%= room.type === 'dog_ward' ? 'selected' : '' %>>Dog Ward - ห้องสุนัข</option>
                  </select>
                </div>
                <div class="col-md-6">
                  <label for="petAmount" class="form-label">จำนวนสัตว์ที่รองรับ <span class="text-danger">*</span></label>
                  <input id="petAmount" name="pet_amount" type="number" class="form-control" min="1" step="1" value="<%= room.pet_amount || 1 %>" required>
                  <div class="form-text">ต้องเป็นจำนวนเต็มมากกว่า 0</div>
                </div>
                <div class="col-md-6">
                  <label for="status" class="form-label">สถานะห้อง <span class="text-danger">*</span></label>
                  <select id="status" name="status" class="form-select" required>
                    <option value="not_full" <%= room.status === 'full' ? '' : 'selected' %>>ยังไม่เต็ม</option>
                    <option value="full" <%= room.status === 'full' ? 'selected' : '' %>>เต็ม</option>
                  </select>
                </div>
                <div class="col-12">
                  <label for="detail" class="form-label">รายละเอียดเพิ่มเติม</label>
                  <textarea id="detail" name="detail" class="form-control" rows="4" placeholder="ข้อมูลเพิ่มเติมเกี่ยวกับห้อง"><%= room.detail || '' %></textarea>
                </div>
              </div>
              <div class="d-flex justify-content-end gap-2 mt-4">
                <a href="/ipd/rooms" class="btn btn-light">ยกเลิก</a>
                <button type="submit" class="btn btn-success">
                  <i class="fa-solid fa-check me-1"></i>บันทึกข้อมูล
                </button>
              </div>
            </form>
          </div>
        </div>
      </main>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>