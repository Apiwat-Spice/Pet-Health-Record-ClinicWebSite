
<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admit Plan - WebClinic</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Prompt', sans-serif;
      background: #f8f9fa;
    }
    .form-card {
      border: 0;
      border-radius: 12px;
    }
    .form-label {
      font-weight: 500;
    }
    .form-error {
      border-radius: 10px;
      padding: 12px 16px;
    }
    .form-error:empty {
      display: none;
    }
    select.form-select {
      position: relative;
    }
  </style>
</head>
<body>
  <%- include('../partial/navbar') %>
  <div class="container-fluid">
    <div class="row">
      <%- include('../partial/menu') %>
      <main class="col-md-9 col-lg-10 px-md-4 py-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
          <div>
            <h3 class="mb-1">
              <%= editing ? 'Edit Admit Plan' : 'Create Admit Plan' %>
            </h3>
            <p class="text-muted mb-0">
              <%= editing ? 'แก้ไขข้อมูลแผนการเข้าพักรักษาสัตว์เลี้ยง' : 'เพิ่มแผนการเข้าพักรักษาสัตว์เลี้ยง' %>
            </p>
          </div>
          <a href="/ipd/admit-plans" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i> กลับ
          </a>
        </div>

        <form action="<%= editing ? `/ipd/admit-plans/${planId}/edit` : '/ipd/admit-plans/create' %>" method="POST" id="admitPlanForm" novalidate>
          <div id="formError" class="alert alert-danger form-error mb-3 <%= error ? '' : 'd-none' %>" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i>
            <span id="formErrorMessage"><%= error || '' %></span>
          </div>

          <div class="card form-card shadow-sm mb-4">
            <div class="card-body p-4">
              <h5 class="mb-3"><i class="fa-solid fa-bed me-2"></i>Room Information</h5>
              <div class="mb-3">
                <label for="room_id" class="form-label">IPD Room <span class="text-danger">*</span></label>
                <select class="form-select" id="room_id" name="room_id" required>
                  <option value="">-- เลือกห้อง --</option>
                  <% rooms.forEach(room => { %>
                    <option value="<%= room.room_id %>" <%= String(form.room_id || '') === String(room.room_id) ? 'selected' : '' %>>
                      <%= room.room_code %> · <%= room.type %> · รองรับ <%= room.pet_amount %> ตัว
                    </option>
                  <% }) %>
                </select>
                <% if (!rooms.length) { %>
                  <div class="form-text text-danger">ไม่มีห้องที่พร้อมรับสัตว์ กรุณาตรวจสอบสถานะห้อง</div>
                <% } %>
              </div>
            </div>
          </div>

          <div class="card form-card shadow-sm mb-4">
            <div class="card-body p-4">
              <h5 class="mb-3"><i class="fa-solid fa-paw me-2"></i>Pet Information</h5>
              <div class="mb-3">
                <label for="pet_owner_id" class="form-label">Pet Owner <span class="text-danger">*</span></label>
                <select class="form-select" id="pet_owner_id" name="pet_owner_id" required>
                  <option value="">-- เลือกเจ้าของสัตว์เลี้ยง --</option>
                  <% owners.forEach(owner => { %>
                    <option value="<%= owner.pet_owner_id %>" <%= String(form.pet_owner_id || '') === String(owner.pet_owner_id) ? 'selected' : '' %>>
                      <%= owner.first_name %> <%= owner.last_name %> (<%= owner.username %>)
                    </option>
                  <% }) %>
                </select>
              </div>
              <div class="mb-3">
                <label for="pet_id" class="form-label">Pet <span class="text-danger">*</span></label>
                <select class="form-select" id="pet_id" name="pet_id" required>
                  <option value="">-- เลือกสัตว์เลี้ยง --</option>
                </select>
                <div class="form-text">รายชื่อสัตว์เลี้ยงจะแสดงตามเจ้าของที่เลือก</div>
              </div>
            </div>
          </div>

          <div class="card form-card shadow-sm mb-4">
            <div class="card-body p-4">
              <h5 class="mb-3"><i class="fa-regular fa-calendar-check me-2"></i>Admission Schedule</h5>
              <div class="row g-3">
                <div class="col-md-6">
                  <label for="check_in_date" class="form-label">Check-in Date <span class="text-danger">*</span></label>
                  <input type="date" class="form-control" id="check_in_date" name="check_in_date" value="<%= form.check_in_date || '' %>" required>
                </div>
                <div class="col-md-6">
                  <label for="check_in_time" class="form-label">Check-in Time <span class="text-danger">*</span></label>
                  <select class="form-select" id="check_in_time" name="check_in_time" required>
                    <option value="">-- เลือกเวลา Check-in --</option>
                    <% for (let hour = 9; hour <= 16; hour++) { %>
                      <% for (let minute of [0, 30]) { %>
                        <% if (hour < 16 || minute === 0 || hour === 16 && minute === 30) { %>
                          <% const time = `${String(hour).padStart(2, '0')}:${String(minute).padStart(2, '0')}`; %>
                          <option value="<%= time %>" <%= String(form.check_in_time || '').slice(0, 5) === time ? 'selected' : '' %>><%= time %></option>
                        <% } %>
                      <% } %>
                    <% } %>
                  </select>
                  <div class="form-text">เลือกเวลาได้ทุก 30 นาที (09:00–16:30)</div>
                </div>
                <div class="col-md-6">
                  <label for="check_out_date" class="form-label">Check-out Date</label>
                  <input type="date" class="form-control" id="check_out_date" name="check_out_date" value="<%= form.check_out_date || '' %>">
                  <div class="form-text">ไม่บังคับ หากยังไม่ทราบวันออกให้เว้นว่าง</div>
                </div>
                <div class="col-md-6">
                  <label for="check_out_time" class="form-label">Check-out Time</label>
                  <select class="form-select" id="check_out_time" name="check_out_time">
                    <option value="">-- เลือกเวลา Check-out --</option>
                    <% for (let hour = 9; hour <= 16; hour++) { %>
                      <% for (let minute of [0, 30]) { %>
                        <% if (hour < 16 || minute === 0 || hour === 16 && minute === 30) { %>
                          <% const time = `${String(hour).padStart(2, '0')}:${String(minute).padStart(2, '0')}`; %>
                          <option value="<%= time %>" <%= String(form.check_out_time || '').slice(0, 5) === time ? 'selected' : '' %>><%= time %></option>
                        <% } %>
                      <% } %>
                    <% } %>
                  </select>
                  <div class="form-text">เลือกเวลาได้ทุก 30 นาที (09:00–16:30)</div>
                </div>
              </div>
            </div>
          </div>

          <div class="card form-card shadow-sm mb-4">
            <div class="card-body p-4">
              <h5 class="mb-3"><i class="fa-solid fa-notes-medical me-2"></i>Note / Routine</h5>
              <label for="note" class="form-label">รายละเอียดการดูแล</label>
              <textarea class="form-control" id="note" name="note" rows="7" placeholder="ตัวอย่าง Routine:
ให้อาหารวันละ 2 ครั้ง เช้าและเย็น
ให้ยาตามเวลาที่สัตวแพทย์กำหนด
ทำแผลวันละ 1 ครั้ง
ตรวจวัดอุณหภูมิทุก 8 ชั่วโมง
สังเกตการกินอาหารและน้ำ
บันทึกอาการผิดปกติ
แจ้งสัตวแพทย์เมื่อพบอาการผิดปกติ"><%= form.note || '' %></textarea>
            </div>
          </div>

          <div class="d-flex justify-content-end gap-2 mb-4">
            <a href="/ipd/admit-plans" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary" id="submitBtn">
              <i class="fa-solid fa-<%= editing ? 'save' : 'plus' %> me-1"></i>
              <%= editing ? 'Save Changes' : 'Create Admit Plan' %>
            </button>
          </div>
        </form>
      </main>
    </div>
  </div>

  <script>
    const pets = <%- JSON.stringify(pets).replace(/</g, '\\u003c') %>;
    const ownerSelect = document.getElementById('pet_owner_id');
    const petSelect = document.getElementById('pet_id');
    const savedPetId = <%- JSON.stringify(String(form.pet_id || '')) %>;

    const form = document.getElementById('admitPlanForm');
    const formError = document.getElementById('formError');
    const formErrorMessage = document.getElementById('formErrorMessage');
    const submitBtn = document.getElementById('submitBtn');

    const checkInDate = document.getElementById('check_in_date');
    const checkInTime = document.getElementById('check_in_time');
    const checkOutDate = document.getElementById('check_out_date');
    const checkOutTime = document.getElementById('check_out_time');

    function showError(message) {
      formErrorMessage.textContent = message;
      formError.classList.remove('d-none');
      formError.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function hideError() {
      formError.classList.add('d-none');
      formErrorMessage.textContent = '';
    }

    function filterPets() {
      const ownerId = ownerSelect.value;
      const previousPetId = petSelect.value || savedPetId;

      petSelect.innerHTML = '<option value="">-- เลือกสัตว์เลี้ยง --</option>';

      pets.filter(pet => String(pet.pet_owner_id) === ownerId).forEach(pet => {
        const option = document.createElement('option');
        option.value = pet.pet_id;
        option.textContent = `${pet.pet_name} · ${pet.species || pet.animal_type || 'ไม่ระบุสายพันธุ์'}`;
        if (String(pet.pet_id) === previousPetId) option.selected = true;
        petSelect.appendChild(option);
      });

      if (ownerId && petSelect.options.length === 1) {
        petSelect.options[0].textContent = '-- เจ้าของนี้ยังไม่มีข้อมูลสัตว์เลี้ยง --';
      }
    }

    ownerSelect.addEventListener('change', () => {
      petSelect.value = '';
      filterPets();
      hideError();
    });

    filterPets();

    function isValidTime(time) {
      if (!time) return false;
      const [hour, minute] = time.split(':').map(Number);
      const totalMinutes = hour * 60 + minute;
      return totalMinutes >= 540 && totalMinutes <= 990 && minute % 30 === 0;
    }

    function updateCheckOutMin() {
      checkOutDate.min = checkInDate.value;

      if (checkOutDate.value && checkOutDate.value < checkInDate.value) {
        showError('วัน Check-out ต้องไม่อยู่ก่อนวัน Check-in');
      }
    }

    checkInDate.addEventListener('change', updateCheckOutMin);
    checkOutDate.addEventListener('change', hideError);

    form.addEventListener('submit', event => {
      hideError();

      if (!isValidTime(checkInTime.value)) {
        event.preventDefault();
        showError('กรุณาเลือกเวลา Check-in ระหว่าง 09:00–16:30 โดยเลือกทุก 30 นาที');
        return;
      }

      if (Boolean(checkOutDate.value) !== Boolean(checkOutTime.value)) {
        event.preventDefault();
        showError('หากกำหนดวันออก ต้องระบุทั้งวันที่และเวลา Check-out');
        return;
      }

      if (checkOutTime.value && !isValidTime(checkOutTime.value)) {
        event.preventDefault();
        showError('กรุณาเลือกเวลา Check-out ระหว่าง 09:00–16:30 โดยเลือกทุก 30 นาที');
        return;
      }

      if (checkOutDate.value && checkOutDate.value < checkInDate.value) {
        event.preventDefault();
        showError('วัน Check-out ต้องไม่อยู่ก่อนวัน Check-in');
        return;
      }

      if (checkOutDate.value === checkInDate.value &&
          checkOutTime.value && checkOutTime.value < checkInTime.value) {
        event.preventDefault();
        showError('เวลา Check-out ต้องไม่อยู่ก่อนเวลา Check-in');
        return;
      }

      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> กำลังบันทึก...';
    });

    [checkInDate, checkInTime, checkOutDate, checkOutTime].forEach(input => {
      input.addEventListener('change', hideError);
    });
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
