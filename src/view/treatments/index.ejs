
<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Treatment - WebClinic</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body class="bg-light">
  <%- include('../partial/navbar') %>
  <div class="container-fluid">
    <div class="row">
      <%- include('../partial/menu') %>
      <main class="col-md-9 col-lg-10 p-4">
        <div class="mb-4">
          <h2 class="fw-bold"><i class="fa-solid fa-file-medical text-primary me-2"></i>Treatment</h2>
          <p class="text-muted mb-0">รายการนัดหมายสำหรับการรักษาสัตว์</p>
        </div>
        <% if (locals.error) { %>
          <div class="alert alert-danger"><%= error %></div>
        <% } %>
        <% if (locals.success) { %>
          <div class="alert alert-success"><%= success %></div>
        <% } %>
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-body">
            <% if (role === 'clinic') { %>
              <form action="/treatments" method="GET" class="row g-3 align-items-end">
                <div class="col-md-6">
                  <label class="form-label">เลือกสัตวแพทย์</label>
                  <select name="vet_id" class="form-select">
                    <option value="">สัตวแพทย์ทุกคน</option>
                    <% vets.forEach(v => { %>
                      <option value="<%= v.vet_id %>" <%= String(selectedVet) === String(v.vet_id) ? 'selected' : '' %>>
                        <%= v.first_name %> <%= v.last_name %>
                      </option>
                    <% }) %>
                  </select>
                </div>
                <div class="col-md-3">
                  <button class="btn btn-primary w-100"><i class="fa-solid fa-filter me-1"></i>ค้นหา</button>
                </div>
              </form>
             <% } else if (role === 'vet') { %>
    <div class="text-muted">
      <i class="fa-solid fa-user-doctor me-1"></i>
      แสดงข้อมูลการรักษาของคุณ
    </div>
  <% } %>
          </div>
        </div>
        <div class="card border-0 shadow-sm">
          <div class="card-body">
            <div class="table-responsive">
              <table class="table table-hover align-middle">
                <thead class="table-light">
                  <tr>
                    <th>วันและเวลา</th>
                    <th>สัตว์</th>
                    <th>เจ้าของ</th>
                    <th>รายการ</th>
                    <th>Vet</th>
                    <th>สถานะ</th>
                    <th>การทำงาน</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (!appointments.length) { %>
                    <tr><td colspan="7" class="text-center text-muted py-4">ไม่พบ Appointment</td></tr>
                  <% } %>
                  <% appointments.forEach(a => { %>
                    <tr>
                      
                      <td class="text-nowrap">
                        <div><%= a.appointment_date %></div>
                        <small class="text-muted"><%= String(a.appointment_time || '').slice(0,5) %></small>
                      </td>
                      <td>
                        <div class="fw-semibold"><i class="fa-solid fa-paw text-primary me-1"></i><%= a.pet_name || 0 %></div>
                        <small class="text-muted">#<%= a.appointment_id %></small>
                      </td>
                      <td><%= a.owner_name %></td>
                      <td>
                        <div><%= a.title || '-' %></div>
                        <small class="text-muted"><%= a.type || '-' %></small>
                      </td>
                      <td><%= a.vet_name %></td>
                      <td>
                        <% if (a.status === 'confirmed') { %>
                          <span class="badge text-bg-primary">Confirmed</span>
                        <% } else if (a.status === 'completed') { %>
                          <span class="badge text-bg-success">Completed</span>
                        <% } else if (a.status === 'cancelled') { %>
                          <span class="badge text-bg-danger">Cancelled</span>
                        <% } else { %>
                          <span class="badge text-bg-warning">Pending</span>
                        <% } %>
                      </td>
                      
<td class="text-nowrap">
  <% if (role === 'vet' && a.visit_record?.status === 'Ready') { %>
    <a href="/treatments/<%= a.appointment_id %>" class="btn btn-sm btn-primary">
      <i class="fa-solid fa-pen-to-square me-1"></i>แก้ไขการรักษา
    </a>
  <% } else if (role === 'vet' && ['Finish', 'Completed'].includes(a.visit_record?.status)) { %>
    <a href="/treatments/<%= a.appointment_id %>" class="btn btn-sm btn-outline-secondary">
      <i class="fa-solid fa-eye me-1"></i>ดูประวัติ
    </a>
  <% } else if (role === 'clinic' && a.visit_record) { %>
    <a href="/treatments/<%= a.appointment_id %>" class="btn btn-sm btn-outline-primary">
      <i class="fa-solid fa-eye me-1"></i>ดูข้อมูล
    </a>
  <% } else { %>
    <span class="text-muted small">ยังไม่มี Visit Record</span>
  <% } %>
</td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
