
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - WebClinic</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body class="bg-light">
    <%- include('partial/navbar') %>
    <div class="container-fluid">
        <div class="row">
            <%- include('partial/menu') %>
            <main class="col-md-9 col-lg-10 p-4">
                <div class="mb-4">
                    <h2 class="fw-bold">Dashboard</h2>
                    <p class="text-muted">WebClinic Management System</p>
                </div>

                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-4">
                            <i class="fa-solid fa-user-shield me-1"></i>
                            Login Information
                        </h5>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="text-muted">Email</label>
                                <div class="fw-bold"><%= user.email %></div>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="text-muted">User Role</label>
                                <div>
                                    <% if (user.role === 'clinic') { %>
                                        <span class="badge bg-primary fs-6">
                                            <i class="fa-solid fa-hospital me-1"></i> CLINIC
                                        </span>
                                    <% } else if (user.role === 'vet') { %>
                                        <span class="badge bg-success fs-6">
                                            <i class="fa-solid fa-user-doctor me-1"></i> VET
                                        </span>
                                    <% } else if (user.role === 'clinic_staff') { %>
                                        <span class="badge bg-warning text-dark fs-6">
                                            <i class="fa-solid fa-hospital me-1"></i> CLINIC STAFF
                                        </span>
                                    <% } else { %>
                                        <span class="badge bg-secondary">UNKNOWN ROLE</span>
                                    <% } %>
                                </div>
                            </div>
                        </div>

                        <hr>

                        <% if (user.role === 'clinic') { %>
                            <div class="alert alert-primary mb-0">
                                <i class="fa-solid fa-hospital me-1"></i>
                                <strong>CLINIC</strong>
                                <p class="mb-0 mt-2">จัดการระบบคลินิกได้ทุกส่วน รวมถึงการเพิ่มสมาชิก Vet และ Clinic Staff</p>
                            </div>
                        <% } else if (user.role === 'vet') { %>
                            <div class="alert alert-success mb-0">
                                <i class="fa-solid fa-user-doctor me-1"></i>
                                <strong>VET</strong>
                                <p class="mb-0 mt-2">จัดการข้อมูลสัตว์เลี้ยง ห้องพัก IPD และการรักษา</p>
                            </div>
                        <% } else if (user.role === 'clinic_staff') { %>
                            <div class="alert alert-warning mb-0">
                                <i class="fa-solid fa-hospital me-1"></i>
                                <strong>CLINIC STAFF</strong>
                                <p class="mb-0 mt-2">จัดการข้อมูลสัตว์เลี้ยง การนัดหมาย Stock และห้องพัก IPD</p>
                            </div>
                        <% } %>
                    </div>
                </div>

                <h5 class="fw-bold mb-3">Management Menu</h5>

                <div class="row g-4">
                    <% if (['clinic', 'clinic_staff', 'vet'].includes(user.role)) { %>
                        <div class="col-md-4">
                            <a href="/pets" class="text-decoration-none">
                                <div class="card border-0 shadow-sm h-100">
                                    <div class="card-body">
                                        <i class="fa-solid fa-paw fa-2x text-primary"></i>
                                        <h5 class="mt-3 text-dark">Pets</h5>
                                        <p class="text-muted mb-0">จัดการข้อมูลสัตว์เลี้ยง</p>
                                    </div>
                                </div>
                            </a>
                        </div>

                        <div class="col-md-4">
                            <a href="/pet-owners" class="text-decoration-none">
                                <div class="card border-0 shadow-sm h-100">
                                    <div class="card-body">
                                        <i class="fa-solid fa-users fa-2x text-primary"></i>
                                        <h5 class="mt-3 text-dark">Pet Owners</h5>
                                        <p class="text-muted mb-0">จัดการข้อมูลเจ้าของสัตว์เลี้ยง</p>
                                    </div>
                                </div>
                            </a>
                        </div>
                    <% } %>

                    <% if (['clinic', 'clinic_staff'].includes(user.role)) { %>
                        <div class="col-md-4">
                            <a href="/appointments" class="text-decoration-none">
                                <div class="card border-0 shadow-sm h-100">
                                    <div class="card-body">
                                        <i class="fa-solid fa-calendar-check fa-2x text-warning"></i>
                                        <h5 class="mt-3 text-dark">Appointment</h5>
                                        <p class="text-muted mb-0">จัดการข้อมูลนัดหมาย</p>
                                    </div>
                                </div>
                            </a>
                        </div>

                        <div class="col-md-4">
                            <a href="/visit-records" class="text-decoration-none">
                                <div class="card border-0 shadow-sm h-100">
                                    <div class="card-body">
                                        <i class="fa-solid fa-file-medical fa-2x text-warning"></i>
                                        <h5 class="mt-3 text-dark">Visit Record</h5>
                                        <p class="text-muted mb-0">จัดการประวัติการเข้ารับบริการ</p>
                                    </div>
                                </div>
                            </a>
                        </div>

                        <div class="col-md-4">
                            <a href="/receipt" class="text-decoration-none">
                                <div class="card border-0 shadow-sm h-100">
                                    <div class="card-body">
                                        <i class="fa-solid fa-receipt fa-2x text-warning"></i>
                                        <h5 class="mt-3 text-dark">Receipt</h5>
                                        <p class="text-muted mb-0">จัดการใบเสร็จและธุรกรรม</p>
                                    </div>
                                </div>
                            </a>
                        </div>

                        <div class="col-md-4">
                            <a href="/stock/overview" class="text-decoration-none">
                                <div class="card border-0 shadow-sm h-100">
                                    <div class="card-body">
                                        <i class="fa-solid fa-boxes-stacked fa-2x text-warning"></i>
                                        <h5 class="mt-3 text-dark">Stock</h5>
                                        <p class="text-muted mb-0">จัดการคลังสินค้า</p>
                                    </div>
                                </div>
                            </a>
                        </div>
                    <% } %>

                    <% if (['clinic', 'clinic_staff', 'vet'].includes(user.role)) { %>
                        <div class="col-md-4">
                            <a href="/ipd/rooms" class="text-decoration-none">
                                <div class="card border-0 shadow-sm h-100">
                                    <div class="card-body">
                                        <i class="fa-solid fa-bed fa-2x text-primary"></i>
                                        <h5 class="mt-3 text-dark">IPD Rooms</h5>
                                        <p class="text-muted mb-0">จัดการห้องพักสัตว์ป่วย</p>
                                    </div>
                                </div>
                            </a>
                        </div>

                        <div class="col-md-4">
                            <a href="/ipd/admit-plans" class="text-decoration-none">
                                <div class="card border-0 shadow-sm h-100">
                                    <div class="card-body">
                                        <i class="fa-solid fa-calendar-plus fa-2x text-primary"></i>
                                        <h5 class="mt-3 text-dark">Admit Plans</h5>
                                        <p class="text-muted mb-0">จัดการแผนการรับสัตว์ป่วยเข้าพัก</p>
                                    </div>
                                </div>
                            </a>
                        </div>
                    <% } %>

                    <% if (['clinic', 'vet'].includes(user.role)) { %>
                        <div class="col-md-4">
                            <a href="/treatments" class="text-decoration-none">
                                <div class="card border-0 shadow-sm h-100">
                                    <div class="card-body">
                                        <i class="fa-solid fa-file-medical fa-2x text-success"></i>
                                        <h5 class="mt-3 text-dark">Treatment</h5>
                                        <p class="text-muted mb-0">จัดการข้อมูลการรักษา</p>
                                    </div>
                                </div>
                            </a>
                        </div>
                    <% } %>

                    <% if (user.role === 'clinic') { %>
                        <div class="col-md-4">
                            <a href="/members/clinic-staff" class="text-decoration-none">
                                <div class="card border-0 shadow-sm h-100">
                                    <div class="card-body">
                                        <i class="fa-solid fa-users-gear fa-2x text-primary"></i>
                                        <h5 class="mt-3 text-dark">Add Member</h5>
                                        <p class="text-muted mb-0">เพิ่ม Vet และ Clinic Staff</p>
                                    </div>
                                </div>
                            </a>
                        </div>
                    <% } %>

                    <div class="col-md-4">
                        <a href="/settings" class="text-decoration-none">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body">
                                    <i class="fa-solid fa-gear fa-2x text-secondary"></i>
                                    <h5 class="mt-3 text-dark">Settings</h5>
                                    <p class="text-muted mb-0">ตั้งค่าบัญชีผู้ใช้งาน</p>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
