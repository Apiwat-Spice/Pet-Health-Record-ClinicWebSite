<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >
    <title>Dashboard - WebClinic</title>
    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
    <!-- Font Awesome -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >
</head>
<body class="bg-light">
<!-- =========================
     Navbar
========================= -->
<nav class="navbar navbar-dark bg-primary">
    <div class="container-fluid">
        <a
            class="navbar-brand fw-bold"
            href="/dashboard"
        >
            <i class="fa-solid fa-house-medical"></i>
            WebClinic
        </a>
        <div class="text-white">
            <i class="fa-solid fa-user"></i>
            <%= user.email %>
            <a
                href="/logout"
                class="btn btn-light btn-sm ms-3"
            >
                <i class="fa-solid fa-right-from-bracket"></i>
                Logout
            </a>
        </div>
    </div>
</nav>
<div class="container-fluid">
    <div class="row">
        <!-- =========================
             Sidebar
        ========================= -->
        <aside class="col-md-3 col-lg-2 bg-white min-vh-100 border-end p-3">
            <h6 class="text-muted mb-3">
                MENU
            </h6>
            <div class="list-group">
                <a
                    href="/dashboard"
                    class="list-group-item list-group-item-action active"
                >
                    <i class="fa-solid fa-gauge"></i>
                    Dashboard
                </a>
                <% if (user.role === 'pet_owner') { %>
                    <a
                        href="#"
                        class="list-group-item list-group-item-action"
                    >
                        <i class="fa-solid fa-paw"></i>
                        My Pets
                    </a>
                    <a
                        href="#"
                        class="list-group-item list-group-item-action"
                    >
                        <i class="fa-solid fa-calendar"></i>
                        Appointment
                    </a>
                <% } %>
                <% if (user.role === 'vet') { %>
                    <a
                        href="#"
                        class="list-group-item list-group-item-action"
                    >
                        <i class="fa-solid fa-paw"></i>
                        Pets
                    </a>
                    <a
                        href="#"
                        class="list-group-item list-group-item-action"
                    >
                        <i class="fa-solid fa-calendar-check"></i>
                        Appointment
                    </a>
                    <a
                        href="#"
                        class="list-group-item list-group-item-action"
                    >
                        <i class="fa-solid fa-file-medical"></i>
                        Treatment
                    </a>
                <% } %>
                <% if (user.role === 'clinic_staff') { %>
                    <a
                        href="#"
                        class="list-group-item list-group-item-action"
                    >
                        <i class="fa-solid fa-calendar-check"></i>
                        Appointment
                    </a>
                    <a
                        href="#"
                        class="list-group-item list-group-item-action"
                    >
                        <i class="fa-solid fa-receipt"></i>
                        Transaction
                    </a>
                <% } %>
                <a
                    href="#"
                    class="list-group-item list-group-item-action"
                >
                    <i class="fa-solid fa-gear"></i>
                    Settings
                </a>
                <a
                    href="/logout"
                    class="list-group-item list-group-item-action text-danger"
                >
                    <i class="fa-solid fa-right-from-bracket"></i>
                    Logout
                </a>
            </div>
        </aside>
        <!-- =========================
             Main Content
        ========================= -->
        <main class="col-md-9 col-lg-10 p-4">
            <div class="mb-4">
                <h2 class="fw-bold">
                    Dashboard
                </h2>
                <p class="text-muted">
                    WebClinic Management System
                </p>
            </div>
            <!-- =========================
                 Role Information
            ========================= -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4">
                        <i class="fa-solid fa-user-shield"></i>
                        Login Information
                    </h5>
                    <div class="row">
                        <!-- Email -->
                        <div class="col-md-6 mb-3">
                            <label class="text-muted">
                                Email
                            </label>
                            <div class="fw-bold">
                                <%= user.email %>
                            </div>
                        </div>
                        <!-- Role -->
                        <div class="col-md-6 mb-3">
                            <label class="text-muted">
                                User Role
                            </label>
                            <div>
                                <% if (user.role === 'pet_owner') { %>
                                    <span class="badge bg-primary fs-6">
                                        <i class="fa-solid fa-paw"></i>
                                        PET OWNER
                                    </span>
                                <% } else if (user.role === 'vet') { %>
                                    <span class="badge bg-success fs-6">
                                        <i class="fa-solid fa-user-doctor"></i>
                                        VET
                                    </span>
                                <% } else if (user.role === 'clinic_staff') { %>
                                    <span class="badge bg-warning text-dark fs-6">
                                        <i class="fa-solid fa-hospital"></i>
                                        CLINIC STAFF
                                    </span>
                                <% } else { %>
                                    <span class="badge bg-secondary">
                                        UNKNOWN ROLE
                                    </span>
                                <% } %>
                            </div>
                        </div>
                    </div>
                    <!-- =========================
                         Role Description
                    ========================= -->
                    <hr>
                    <% if (user.role === 'pet_owner') { %>
                        <div class="alert alert-primary mb-0">
                            <i class="fa-solid fa-paw"></i>
                            <strong>Pet Owner</strong>
                            <br>
                            ผู้ใช้งานสำหรับจัดการข้อมูลสัตว์เลี้ยง
                            ประวัติสุขภาพ และการนัดหมาย
                        </div>
                    <% } else if (user.role === 'vet') { %>
                        <div class="alert alert-success mb-0">
                            <i class="fa-solid fa-user-doctor"></i>
                            <strong>Vet</strong>
                            <br>
                            ผู้ใช้งานสำหรับสัตวแพทย์
                            จัดการการรักษา วินิจฉัย
                            วัคซีน และนัดหมาย
                        </div>
                    <% } else if (user.role === 'clinic_staff') { %>
                        <div class="alert alert-warning mb-0">
                            <i class="fa-solid fa-hospital"></i>
                            <strong>Clinic Staff</strong>
                            <br>
                            เจ้าหน้าที่คลินิก
                            สำหรับจัดการนัดหมายและธุรกรรม
                            ตามสิทธิ์ของเจ้าหน้าที่
                        </div>
                    <% } %>
                </div>
            </div>
            <!-- =========================
                 Role Cards
            ========================= -->
            <div class="row g-4">
                <% if (user.role === 'pet_owner') { %>
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <i class="fa-solid fa-paw fa-2x text-primary"></i>
                                <h5 class="mt-3">
                                    My Pets
                                </h5>
                                <p class="text-muted">
                                    จัดการข้อมูลสัตว์เลี้ยง
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <i class="fa-solid fa-calendar fa-2x text-primary"></i>
                                <h5 class="mt-3">
                                    Appointment
                                </h5>
                                <p class="text-muted">
                                    จัดการนัดหมายกับคลินิก
                                </p>
                            </div>
                        </div>
                    </div>
                <% } %>
                <% if (user.role === 'vet') { %>
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <i class="fa-solid fa-paw fa-2x text-success"></i>
                                <h5 class="mt-3">
                                    Pets
                                </h5>
                                <p class="text-muted">
                                    ดูข้อมูลสัตว์เลี้ยงและประวัติสุขภาพ
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <i class="fa-solid fa-file-medical fa-2x text-success"></i>
                                <h5 class="mt-3">
                                    Treatment
                                </h5>
                                <p class="text-muted">
                                    บันทึกข้อมูลการรักษา
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <i class="fa-solid fa-syringe fa-2x text-success"></i>
                                <h5 class="mt-3">
                                    Vaccination
                                </h5>
                                <p class="text-muted">
                                    จัดการข้อมูลวัคซีน
                                </p>
                            </div>
                        </div>
                    </div>
                <% } %>
                <% if (user.role === 'clinic_staff') { %>
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <i class="fa-solid fa-calendar-check fa-2x text-warning"></i>
                                <h5 class="mt-3">
                                    Appointment
                                </h5>
                                <p class="text-muted">
                                    จัดการนัดหมายของคลินิก
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <i class="fa-solid fa-receipt fa-2x text-warning"></i>
                                <h5 class="mt-3">
                                    Transaction
                                </h5>
                                <p class="text-muted">
                                    จัดการข้อมูลธุรกรรม
                                </p>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        </main>
    </div>
</div>
<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
></script>
</body>
</html>
