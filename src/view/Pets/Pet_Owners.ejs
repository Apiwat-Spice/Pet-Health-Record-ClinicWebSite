<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pet Owners - WebClinic</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body class="bg-light">
    <%- include('../partial/navbar') %>
    <div class="container-fluid">
        <div class="row">
            <%- include('../partial/menu') %>
            <main class="col-md-9 col-lg-10 p-4">

                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                    <div>
                        <h2 class="fw-bold mb-1"><i class="fa-solid fa-user-group text-primary"></i> Pet Owners</h2>
                        <p class="text-muted mb-0">จัดการข้อมูลเจ้าของสัตว์เลี้ยง</p>
                    </div>
                    <a href="/pet-owners/create" class="btn btn-primary">
                        <i class="fa-solid fa-plus me-1"></i> เพิ่มเจ้าของสัตว์เลี้ยง
                    </a>
                </div>

                <% if (locals.success) { %>
                    <div class="alert alert-success alert-dismissible fade show">
                        <i class="fa-solid fa-circle-check me-1"></i> <%= success %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>
                <% if (locals.error) { %>
                    <div class="alert alert-danger alert-dismissible fade show">
                        <i class="fa-solid fa-circle-exclamation me-1"></i> <%= error %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>

                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <div class="input-group mb-3" style="max-width: 360px;">
                            <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                            <input type="search" id="searchInput" class="form-control" placeholder="ค้นหาชื่อหรือ username">
                        </div>

                        <% const list = locals.owners || []; %>
                        <% if (list.length === 0) { %>
                            <div class="text-center py-5">
                                <i class="fa-solid fa-user-plus fa-3x text-muted mb-3"></i>
                                <h5>ยังไม่มีเจ้าของสัตว์เลี้ยง</h5>
                                <p class="text-muted">เพิ่มเจ้าของคนแรกเพื่อเริ่มลงทะเบียนสัตว์เลี้ยง</p>
                                <a href="/pet-owners/create" class="btn btn-primary">เพิ่มเจ้าของสัตว์เลี้ยง</a>
                            </div>
                        <% } else { %>
                        <div class="table-responsive">
                            <table class="table align-middle table-hover mb-0" id="ownerTable">
                                <thead class="table-light">
                                    <tr>
                                        <th>เจ้าของ</th>
                                        <th>Username</th>
                                        <th>เพศ</th>
                                        <th>สถานะ</th>
                                        <th class="text-end">จัดการ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                <% list.forEach(o => { %>
                                    <tr data-search="<%= (o.first_name + ' ' + o.last_name + ' ' + o.username).toLowerCase() %>">
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <% if (o.profile_image_url) { %>
                                                    <img src="<%= o.profile_image_url %>" alt="" class="rounded-circle" width="40" height="40" style="object-fit:cover;">
                                                <% } else { %>
                                                    <span class="rounded-circle bg-secondary-subtle text-secondary d-inline-flex align-items-center justify-content-center" style="width:40px;height:40px;">
                                                        <i class="fa-solid fa-user"></i>
                                                    </span>
                                                <% } %>
                                                <span class="fw-semibold"><%= o.first_name %> <%= o.last_name %></span>
                                            </div>
                                        </td>
                                        <td class="text-muted">@<%= o.username %></td>
                                        <td>
                                            <%= { male: 'ชาย', female: 'หญิง', other: 'อื่น ๆ', prefer_not_to_say: 'ไม่ระบุ' }[o.gender] || '-' %>
                                        </td>
                                        <td>
                                            <% if (o.verified) { %><span class="badge text-bg-success">ยืนยันแล้ว</span><% } else { %><span class="badge text-bg-secondary">ยังไม่ยืนยัน</span><% } %>
                                            <% if (o.verified_id_card) { %><span class="badge text-bg-info">บัตรประชาชน</span><% } %>
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <a href="/pets?owner=<%= o.pet_owner_id %>" class="btn btn-sm btn-outline-secondary" title="ดูสัตว์เลี้ยง"><i class="fa-solid fa-paw"></i></a>
                                            <a href="/pet-owners/<%= o.pet_owner_id %>/edit" class="btn btn-sm btn-outline-primary" title="แก้ไข"><i class="fa-solid fa-pen"></i></a>
                                            <button type="button" class="btn btn-sm btn-outline-danger btn-delete"
                                                    data-id="<%= o.pet_owner_id %>"
                                                    data-name="<%= o.first_name %> <%= o.last_name %>"
                                                    data-pets="<%= o.pet_count || 0 %>" title="ลบ">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                <% }) %>
                                </tbody>
                            </table>
                        </div>
                        <p id="noResult" class="text-center text-muted py-4 d-none">ไม่พบผลลัพธ์ ลองค้นหาด้วยคำอื่น</p>
                        <% } %>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- Delete modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form method="POST" id="deleteForm" class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">ลบเจ้าของสัตว์เลี้ยง</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>ต้องการลบ <strong id="delName"></strong> ใช่หรือไม่?</p>
                    <div class="alert alert-warning mb-0 d-none" id="delWarn">
                        <i class="fa-solid fa-triangle-exclamation me-1"></i>
                        สัตว์เลี้ยงของเจ้าของนี้ <strong id="delPets"></strong> ตัวจะถูกลบไปด้วย และกู้คืนไม่ได้
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="submit" class="btn btn-danger"><i class="fa-solid fa-trash me-1"></i> ลบ</button>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
        document.querySelectorAll('.btn-delete').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('deleteForm').action = `/pet-owners/${btn.dataset.id}/delete`;
                document.getElementById('delName').textContent = btn.dataset.name;
                const n = Number(btn.dataset.pets);
                document.getElementById('delPets').textContent = n;
                document.getElementById('delWarn').classList.toggle('d-none', n === 0);
                modal.show();
            });
        });

        const input = document.getElementById('searchInput');
        input?.addEventListener('input', () => {
            const q = input.value.trim().toLowerCase();
            let shown = 0;
            document.querySelectorAll('#ownerTable tbody tr').forEach(tr => {
                const ok = tr.dataset.search.includes(q);
                tr.classList.toggle('d-none', !ok);
                if (ok) shown++;
            });
            document.getElementById('noResult').classList.toggle('d-none', shown > 0);
        });
    </script>
</body>
</html>