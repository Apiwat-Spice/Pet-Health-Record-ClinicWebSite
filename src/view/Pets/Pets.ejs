<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Pets - WebClinic</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body class="bg-light">
    <%
        const pets = locals.pets || [];
        const typeIcon = { dog: 'fa-dog', cat: 'fa-cat', bird: 'fa-dove', fish: 'fa-fish', rabbit: 'fa-carrot' };
        const typeName = { dog: 'สุนัข', cat: 'แมว', bird: 'นก', fish: 'ปลา', rabbit: 'กระต่าย', other: 'อื่น ๆ' };
        const sexIcon = { male: '<i class="fa-solid fa-mars text-primary"></i>', female: '<i class="fa-solid fa-venus text-danger"></i>' };
        function age(b) {
            if (!b) return '-';
            const d = new Date(b), n = new Date();
            let m = (n.getFullYear() - d.getFullYear()) * 12 + n.getMonth() - d.getMonth();
            if (n.getDate() < d.getDate()) m--;
            if (m < 1) return 'ไม่ถึง 1 เดือน';
            return m < 12 ? `${m} เดือน` : `${Math.floor(m / 12)} ปี${m % 12 ? ' ' + (m % 12) + ' เดือน' : ''}`;
        }
    %>
    <%- include('../partial/navbar') %>
    <div class="container-fluid">
        <div class="row">
            <%- include('../partial/menu') %>
            <main class="col-md-9 col-lg-10 p-4">

                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                    <div>
                        <h2 class="fw-bold mb-1"><i class="fa-solid fa-paw text-primary"></i> Pets</h2>
                        <p class="text-muted mb-0">จัดการข้อมูลสัตว์เลี้ยงของคุณ (<%= pets.length %> ตัว)</p>
                    </div>
                    <a href="/pets/create<%= locals.ownerId ? '?owner=' + ownerId : '' %>" class="btn btn-primary">
                        <i class="fa-solid fa-plus me-1"></i> เพิ่มสัตว์เลี้ยง
                    </a>
                </div>

                <% if (locals.success) { %>
                    <div class="alert alert-success alert-dismissible fade show">
                        <i class="fa-solid fa-circle-check me-1"></i> <%= success %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>
                <% if (locals.error) { %>
                    <div class="alert alert-danger alert-dismissible fade show">
                        <i class="fa-solid fa-circle-exclamation me-1"></i> <%= error %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>

                <% if (pets.length === 0) { %>
                    <div class="card border-0 shadow-sm">
                        <div class="card-body text-center py-5">
                            <i class="fa-solid fa-paw fa-3x text-muted mb-3"></i>
                            <h5>ยังไม่มีสัตว์เลี้ยง</h5>
                            <p class="text-muted">เพิ่มข้อมูลสัตว์เลี้ยงตัวแรก แล้วระบบจะสร้าง QR code ให้อัตโนมัติ</p>
                            <a href="/pets/create" class="btn btn-primary">เพิ่มสัตว์เลี้ยง</a>
                        </div>
                    </div>
                <% } else { %>

                <!-- Filters -->
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <div class="input-group" style="max-width: 320px;">
                        <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                        <input type="search" id="searchInput" class="form-control" placeholder="ค้นหาชื่อ / ไมโครชิป / แท็ก">
                    </div>
                    <select id="typeFilter" class="form-select" style="max-width: 180px;">
                        <option value="">สัตว์ทุกชนิด</option>
                        <% Object.entries(typeName).forEach(([k, v]) => { %><option value="<%= k %>"><%= v %></option><% }) %>
                    </select>
                </div>

                <div class="row g-3" id="petGrid">
                <% pets.forEach(p => { %>
                    <div class="col-sm-6 col-xl-4 col-xxl-3 pet-item"
                         data-type="<%= p.animal_type %>"
                         data-search="<%= [p.pet_name, p.species, p.microchip_number, p.pet_tag].join(' ').toLowerCase() %>">
                        <div class="card h-100 shadow-sm border-0">
                            <% if (p.pet_image_url) { %>
                                <img src="<%= p.pet_image_url %>" class="card-img-top" alt="<%= p.pet_name %>" style="height:180px;object-fit:cover;">
                            <% } else { %>
                                <div class="bg-secondary-subtle text-secondary d-flex align-items-center justify-content-center" style="height:180px;">
                                    <i class="fa-solid <%= typeIcon[p.animal_type] || 'fa-paw' %> fa-3x"></i>
                                </div>
                            <% } %>
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start">
                                    <h5 class="card-title mb-1"><%= p.pet_name %> <%- sexIcon[p.sex] || '' %></h5>
                                    <% if (p.verified) { %><i class="fa-solid fa-circle-check text-success" title="ยืนยันแล้ว"></i><% } %>
                                </div>
                                <p class="text-muted small mb-2">
                                    <%= typeName[p.animal_type] || p.animal_type %><%= p.species ? ' · ' + p.species : '' %>
                                </p>
                                <ul class="list-unstyled small mb-2">
                                    <li><i class="fa-solid fa-cake-candles fa-fw text-muted"></i> <%= age(p.birthdate) %></li>
                                    <li><i class="fa-solid fa-weight-scale fa-fw text-muted"></i> <%= p.weight != null ? p.weight + ' กก.' : '-' %></li>
                                    <% if (locals.showOwner && p.owner_name) { %>
                                        <li><i class="fa-solid fa-user fa-fw text-muted"></i> <%= p.owner_name %></li>
                                    <% } %>
                                </ul>
                                <% if (p.sterilization) { %><span class="badge text-bg-light border">ทำหมันแล้ว</span><% } %>
                                <% if (p.microchip_number) { %><span class="badge text-bg-light border"><i class="fa-solid fa-microchip"></i> มีไมโครชิป</span><% } %>
                            </div>
                            <div class="card-footer bg-white border-0 d-flex gap-2 pt-0 pb-3">
                                <a href="/pets/<%= p.pet_id %>/edit" class="btn btn-sm btn-outline-primary flex-fill"><i class="fa-solid fa-pen me-1"></i> แก้ไข</a>
                                <button type="button" class="btn btn-sm btn-outline-danger btn-delete"
                                        data-id="<%= p.pet_id %>" data-name="<%= p.pet_name %>" title="ลบ">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                <% }) %>
                </div>
                <p id="noResult" class="text-center text-muted py-5 d-none">ไม่พบสัตว์เลี้ยงที่ตรงกับเงื่อนไข</p>
                <% } %>
            </main>
        </div>
    </div>

    <!-- Delete modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form method="POST" id="deleteForm" class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">ลบสัตว์เลี้ยง</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    ต้องการลบ <strong id="delName"></strong> ใช่หรือไม่? ข้อมูลและ QR code จะถูกลบถาวร
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="submit" class="btn btn-danger"><i class="fa-solid fa-trash me-1"></i> ลบ</button>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
        document.querySelectorAll('.btn-delete').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('deleteForm').action = `/pets/${btn.dataset.id}/delete`;
                document.getElementById('delName').textContent = btn.dataset.name;
                modal.show();
            });
        });

        const q = document.getElementById('searchInput'), t = document.getElementById('typeFilter');
        function applyFilter() {
            const text = (q?.value || '').trim().toLowerCase(), type = t?.value || '';
            let shown = 0;
            document.querySelectorAll('.pet-item').forEach(el => {
                const ok = el.dataset.search.includes(text) && (!type || el.dataset.type === type);
                el.classList.toggle('d-none', !ok);
                if (ok) shown++;
            });
            document.getElementById('noResult')?.classList.toggle('d-none', shown > 0);
        }
        q?.addEventListener('input', applyFilter);
        t?.addEventListener('change', applyFilter);
    </script>
</body>
</html>