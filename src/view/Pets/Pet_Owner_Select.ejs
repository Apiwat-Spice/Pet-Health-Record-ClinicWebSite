
<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>เลือกเจ้าของสัตว์เลี้ยง - WebClinic</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body class="bg-light">
  <%- include('../partial/navbar') %>
  <div class="container-fluid">
    <div class="row">
      <%- include('../partial/menu') %>
      <main class="col-md-9 col-lg-10 p-4">
        <div class="mb-4">
          <h2 class="fw-bold"><i class="fa-solid fa-user-check text-primary me-2"></i>เลือกเจ้าของสัตว์เลี้ยง</h2>
          <p class="text-muted">เลือกเจ้าของก่อนเข้าสู่แบบฟอร์มเพิ่มสัตว์เลี้ยง</p>
        </div>
        <% if (error) { %>
          <div class="alert alert-danger"><%= error %></div>
        <% } %>
        <div class="card border-0 shadow-sm mb-3">
          <div class="card-body">
            <input type="search" id="ownerSearch" class="form-control" placeholder="ค้นหาชื่อ นามสกุล Username หรืออีเมล">
          </div>
        </div>
        <% if (!owners.length) { %>
          <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
              <i class="fa-solid fa-users fa-3x text-muted mb-3"></i>
              <h5>ยังไม่มีเจ้าของสัตว์เลี้ยง</h5>
              <p class="text-muted">กรุณาเพิ่มข้อมูลเจ้าของก่อน</p>
              <a href="/pet-owners/create" class="btn btn-primary">เพิ่มเจ้าของสัตว์เลี้ยง</a>
            </div>
          </div>
        <% } else { %>
          <div class="row g-3" id="ownerGrid">
            <% owners.forEach(o => { %>
              <div class="col-md-6 col-xl-4 owner-item" data-search="<%= [o.first_name, o.last_name, o.username, o.email].filter(Boolean).join(' ').toLowerCase() %>">
                <div class="card border-0 shadow-sm h-100">
                  <div class="card-body">
                    <div class="d-flex gap-3 align-items-center mb-3">
                      <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center" style="width:48px;height:48px;flex-shrink:0">
                        <i class="fa-solid fa-user fa-lg"></i>
                      </div>
                      <div class="min-w-0">
                        <h5 class="mb-1"><%= o.first_name || '' %> <%= o.last_name || '' %></h5>
                        <div class="small text-muted">@<%= o.username || '-' %></div>
                      </div>
                    </div>
                    <p class="small text-muted mb-3"><i class="fa-solid fa-envelope me-2"></i><%= o.email || '-' %></p>
                    <a href="/pets/create/form?owner=<%= o.pet_owner_id %>" class="btn btn-primary w-100">
                      <i class="fa-solid fa-plus me-1"></i>เลือกเจ้าของรายนี้
                    </a>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
          <p id="noResult" class="text-center text-muted py-4 d-none">ไม่พบเจ้าของที่ค้นหา</p>
        <% } %>
        <a href="/pets" class="btn btn-light mt-4"><i class="fa-solid fa-arrow-left me-1"></i>กลับหน้าสัตว์เลี้ยง</a>
      </main>
    </div>
  </div>
  <script>
    const search = document.getElementById('ownerSearch');
    search?.addEventListener('input', () => {
      const keyword = search.value.trim().toLowerCase();
      let count = 0;
      document.querySelectorAll('.owner-item').forEach(item => {
        const matched = item.dataset.search.includes(keyword);
        item.classList.toggle('d-none', !matched);
        if (matched) count++;
      });
      document.getElementById('noResult')?.classList.toggle('d-none', count > 0);
    });
  </script>
</body>
</html>
