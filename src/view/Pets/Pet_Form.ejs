<!DOCTYPE html>
<html lang="th">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= locals.pet ? 'แก้ไข' : 'เพิ่ม' %>สัตว์เลี้ยง - WebClinic</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>

<body class="bg-light">
  <%
        const isEdit = !!locals.pet;
        const p = locals.pet || locals.old || {};
        const errors = locals.errors || {};
        const action = isEdit
  ? `/pets/${p.pet_id}/edit`
  : '/pets/create';
        const birth = p.birthdate ? new Date(p.birthdate).toISOString().slice(0, 10) : '';
        const types = [['dog','สุนัข'],['cat','แมว'],['bird','นก'],['rabbit','กระต่าย'],['fish','ปลา'],['other','อื่น ๆ']];
        const sexes = [['male','ผู้','fa-mars'],['female','เมีย','fa-venus'],['unknown','ไม่ทราบ','fa-question']];
    %>
  <%- include('../partial/navbar') %>
  <div class="container-fluid">
    <div class="row">
      <%- include('../partial/menu') %>
      <main class="col-md-9 col-lg-10 p-4">

        <nav aria-label="breadcrumb">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/pets">Pets</a></li>
            <li class="breadcrumb-item active"><%= isEdit ? 'แก้ไข' : 'เพิ่มใหม่' %></li>
          </ol>
        </nav>

        <h2 class="fw-bold mb-4">
          <i class="fa-solid fa-paw text-primary"></i>
          <%= isEdit ? 'แก้ไขข้อมูล ' + (p.pet_name || '') : 'เพิ่มสัตว์เลี้ยง' %>
        </h2>

        <% if (locals.error) { %>
        <div class="alert alert-danger"><i class="fa-solid fa-circle-exclamation me-1"></i> <%= error %></div>
        <% } %>

        <form method="POST" action="<%= action %>" enctype="multipart/form-data" novalidate>

          <div class="card shadow-sm border-0 mb-3">
            <div class="card-body p-4">
              <h5 class="mb-3">ข้อมูลทั่วไป</h5>
              <div class="row g-4">

                <div class="col-md-3 text-center">
                  <img id="preview" src="<%= p.pet_image_url || 'data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22200%22 height=%22200%22><rect width=%22200%22 height=%22200%22 fill=%22%23e9ecef%22/></svg>' %>" class="rounded border mb-3 w-100" style="max-width:200px;aspect-ratio:1;object-fit:cover;" alt="รูปสัตว์เลี้ยง">
                  <input type="file" name="pet_image" id="petImage" class="form-control form-control-sm" accept="image/png,image/jpeg,image/webp">
                  <div class="form-text">JPG, PNG, WebP ไม่เกิน 5 MB</div>
                </div>

                <div class="col-md-9">
                  <div class="row g-3">

                    <% if (locals.owners) { %>
                    <div class="col-12">
                      <label class="form-label" for="pet_owner_id">เจ้าของ <span class="text-danger">*</span></label>
                      <select id="pet_owner_id" name="pet_owner_id" required class="form-select" <%= locals.ownerId ? 'disabled' : '' %>>
                        <option value="">เลือกเจ้าของ</option>
                        <% owners.forEach(o => { %>
                        <option value="<%= o.pet_owner_id %>" <%= String(p.pet_owner_id || locals.ownerId) === String(o.pet_owner_id) ? 'selected' : '' %>>
                          <%= o.first_name %> <%= o.last_name %> (@<%= o.username %>)
                        </option>
                        <% }) %>
                      </select>
                      <% if (locals.ownerId) { %>
                      <input type="hidden" name="pet_owner_id" value="<%= ownerId %>">
                      <% } %>
                      <div class="invalid-feedback"><%= errors.pet_owner_id || 'กรุณาเลือกเจ้าของ' %></div>
                    </div>
                    <% } %>

                    <div class="col-md-6">
                      <label class="form-label" for="pet_name">ชื่อสัตว์เลี้ยง <span class="text-danger">*</span></label>
                      <input type="text" id="pet_name" name="pet_name" maxlength="100" required class="form-control <%= errors.pet_name ? 'is-invalid' : '' %>" value="<%= p.pet_name || '' %>">
                      <div class="invalid-feedback"><%= errors.pet_name || 'กรุณากรอกชื่อสัตว์เลี้ยง' %></div>
                    </div>

                    <div class="col-md-6">
                      <label class="form-label" for="animal_type">ชนิดสัตว์ <span class="text-danger">*</span></label>
                      <select id="animal_type" name="animal_type" required class="form-select <%= errors.animal_type ? 'is-invalid' : '' %>">
                        <option value="">เลือกชนิด</option>
                        <% types.forEach(([v, t]) => { %>
                        <option value="<%= v %>" <%= p.animal_type === v ? 'selected' : '' %>><%= t %></option>
                        <% }) %>
                      </select>
                      <div class="invalid-feedback"><%= errors.animal_type || 'กรุณาเลือกชนิดสัตว์' %></div>
                    </div>

                    <div class="col-md-6">
                      <label class="form-label" for="species">สายพันธุ์</label>
                      <input type="text" id="species" name="species" maxlength="100" class="form-control" placeholder="เช่น ชิวาวา, วิเชียรมาศ" value="<%= p.species || '' %>">
                    </div>

                    <div class="col-md-6">
                      <label class="form-label d-block">เพศ <span class="text-danger">*</span></label>
                      <div class="btn-group" role="group">
                        <% sexes.forEach(([v, t, ic]) => { %>
                        <input type="radio" class="btn-check" name="sex" id="sex_<%= v %>" value="<%= v %>" <%= (p.sex || 'unknown') === v ? 'checked' : '' %>>
                        <label class="btn btn-outline-secondary" for="sex_<%= v %>"><i class="fa-solid <%= ic %> me-1"></i><%= t %></label>
                        <% }) %>
                      </div>
                    </div>

                    <div class="col-md-6">
                      <label class="form-label" for="birthdate">วันเกิด</label>
                      <input type="date" id="birthdate" name="birthdate" class="form-control" max="<%= new Date().toISOString().slice(0,10) %>" value="<%= birth %>">
                    </div>

                    <div class="col-md-6">
                      <label class="form-label" for="weight">น้ำหนัก</label>
                      <div class="input-group has-validation">
                        <input type="number" id="weight" name="weight" step="0.01" min="0" max="9999.99" class="form-control <%= errors.weight ? 'is-invalid' : '' %>" value="<%= p.weight ?? '' %>">
                        <span class="input-group-text">กก.</span>
                        <div class="invalid-feedback"><%= errors.weight || 'น้ำหนักต้องไม่ติดลบ' %></div>
                      </div>
                    </div>

                    <div class="col-12">
                      <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="sterilization" name="sterilization" value="true" <%= p.sterilization ? 'checked' : '' %>>
                        <label class="form-check-label" for="sterilization">ทำหมันแล้ว</label>
                      </div>
                      <% if (locals.isAdmin) { %>
                      <div class="form-check form-switch mt-2">
                        <input class="form-check-input" type="checkbox" role="switch" id="verified" name="verified" value="true" <%= p.verified ? 'checked' : '' %>>
                        <label class="form-check-label" for="verified">คลินิกยืนยันข้อมูลแล้ว</label>
                      </div>
                      <% } %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="card shadow-sm border-0 mb-3">
            <div class="card-body p-4">
              <h5 class="mb-3">การระบุตัวตนและรายละเอียด</h5>
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label" for="microchip_number">เลขไมโครชิป</label>
                  <input type="text" id="microchip_number" name="microchip_number" maxlength="50" inputmode="numeric" class="form-control <%= errors.microchip_number ? 'is-invalid' : '' %>" value="<%= p.microchip_number || '' %>">
                  <div class="invalid-feedback"><%= errors.microchip_number || 'เลขไมโครชิปนี้ถูกใช้แล้ว' %></div>
                </div>
                <div class="col-md-6">
                  <label class="form-label" for="pet_tag">แท็กสัตว์เลี้ยง</label>
                  <input type="text" id="pet_tag" name="pet_tag" maxlength="50" class="form-control" value="<%= p.pet_tag || '' %>">
                </div>
                <div class="col-12">
                  <label class="form-label" for="detail">รายละเอียดเพิ่มเติม</label>
                  <textarea id="detail" name="detail" rows="3" class="form-control" placeholder="เช่น โรคประจำตัว, ประวัติแพ้ยา, นิสัย"><%= p.detail || '' %></textarea>
                </div>
                <% if (isEdit && p.qr_code) { %>
                <div class="col-12">
                  <label class="form-label">QR code</label>
                  <div class="input-group">
                    <span class="input-group-text"><i class="fa-solid fa-qrcode"></i></span>
                    <input type="text" class="form-control" value="<%= p.qr_code %>" readonly>
                  </div>
                  <div class="form-text">สร้างโดยระบบ แก้ไขไม่ได้</div>
                </div>
                <% } %>
              </div>
            </div>
          </div>

          <div class="d-flex justify-content-between">
            <% if (isEdit) { %>
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
              <i class="fa-solid fa-trash me-1"></i> ลบสัตว์เลี้ยง
            </button>
            <% } else { %><span></span><% } %>
            <div class="d-flex gap-2">
              <a href="/pets" class="btn btn-light">ยกเลิก</a>
              <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-floppy-disk me-1"></i> <%= isEdit ? 'บันทึกการแก้ไข' : 'เพิ่มสัตว์เลี้ยง' %>
              </button>
            </div>
          </div>
        </form>
      </main>
    </div>
  </div>

  <% if (isEdit) { %>
  <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <form method="POST" action="/pets/<%= p.pet_id %>/delete" class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">ลบสัตว์เลี้ยง</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">ต้องการลบ <strong><%= p.pet_name %></strong> ใช่หรือไม่? ข้อมูลและ QR code จะถูกลบถาวร</div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">ยกเลิก</button>
          <button type="submit" class="btn btn-danger"><i class="fa-solid fa-trash me-1"></i> ลบ</button>
        </div>
      </form>
    </div>
  </div>
  <% } %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    document.getElementById('petImage').addEventListener('change', e => {
      const f = e.target.files[0];
      if (!f) return;
      if (f.size > 5 * 1024 * 1024) {
        alert('ไฟล์ใหญ่เกิน 5 MB');
        e.target.value = '';
        return;
      }
      document.getElementById('preview').src = URL.createObjectURL(f);
    });
    document.querySelector('form[enctype]').addEventListener('submit', e => {
      const form = e.target;
      if (!form.checkValidity()) {
        e.preventDefault();
        form.querySelectorAll(':invalid').forEach(el => el.classList.add('is-invalid'));
        form.querySelector(':invalid')?.focus();
      }
    });
  </script>
</body>

</html>