<aside class="col-md-3 col-lg-2 bg-white min-vh-100 border-end p-3">
    <h6 class="text-muted mb-3">MENU</h6>

    <div class="list-group">

        <a href="/dashboard"
           class="list-group-item list-group-item-action <%= activePage === 'dashboard' ? 'active' : '' %>">
            <i class="fa-regular fa-compass"></i> Dashboard
        </a>

        <% if (user.role === 'clinic') { %>

            <!-- Pets (Dropdown) -->
            <% const petsOpen = ['pets', 'pet-owners'].includes(activePage); %>

            <a href="#petsMenu"
               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center <%= petsOpen ? 'active' : '' %>"
               data-bs-toggle="collapse"
               role="button"
               aria-expanded="<%= petsOpen ? 'true' : 'false' %>"
               aria-controls="petsMenu">
                <span><i class="fa-solid fa-paw"></i> Pets</span>
                <i class="fa-solid fa-chevron-down small"></i>
            </a>

            <div class="collapse show" id="petsMenu">
                <a href="/pets"
                   class="list-group-item list-group-item-action ps-5 <%= activePage === 'Pets' ? 'active' : '' %>">
                    <i class="fa-solid fa-dog"></i> Pets
                </a>
                <a href="/pet-owners"
                   class="list-group-item list-group-item-action ps-5 <%= activePage === 'Pet_Owners' ? 'active' : '' %>">
                    <i class="fa-solid fa-user"></i> Pet Owners
                </a>
            </div>

            <a href="/appointments"
               class="list-group-item list-group-item-action <%= activePage === 'appointments' ? 'active' : '' %>">
                <i class="fa-solid fa-calendar-check"></i> Appointment
            </a>
            <a href="/treatments"
               class="list-group-item list-group-item-action <%= activePage === 'treatments' ? 'active' : '' %>">
                <i class="fa-solid fa-file-medical"></i> Treatment
            </a>

        <% } %>

        <% if (user.role === 'clinic_staff') { %>
            <a href="/appointments"
               class="list-group-item list-group-item-action <%= activePage === 'appointments' ? 'active' : '' %>">
                <i class="fa-solid fa-calendar-check"></i> Appointment
            </a>
            <a href="/transactions"
               class="list-group-item list-group-item-action <%= activePage === 'transactions' ? 'active' : '' %>">
                <i class="fa-solid fa-receipt"></i> Transaction
            </a>
        <% } %>

        <a href="/settings"
           class="list-group-item list-group-item-action <%= activePage === 'settings' ? 'active' : '' %>">
            <i class="fa-solid fa-gear"></i> Settings
        </a>

        <a href="/logout" class="list-group-item list-group-item-action text-danger">
            <i class="fa-solid fa-right-from-bracket"></i> Logout
        </a>
    </div>
</aside>
<script>
(() => {
    const el = document.getElementById('petsMenu');
    const toggler = document.querySelector('[href="#petsMenu"]');

    // role อื่นไม่มีเมนูนี้ ให้จบการทำงาน
    if (!el || !toggler) return;

    const key = 'menu-closed:petsMenu';

    // ถ้าผู้ใช้เคยกดปิดไว้ ให้ปิดตั้งแต่โหลด
    if (localStorage.getItem(key) === '1') {
        el.classList.remove('show');
        toggler.setAttribute('aria-expanded', 'false');
    }

    // บันทึกเมื่อผู้ใช้กดเปิด/ปิด
    el.addEventListener('hidden.bs.collapse', () => localStorage.setItem(key, '1'));
    el.addEventListener('shown.bs.collapse', () => localStorage.removeItem(key));
})();
</script>